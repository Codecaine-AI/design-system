{
  "name": "@codecaine-ai/design-system",
  "version": "0.2.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Codecaine-AI/design-system.git"
  },
  "description": "One look for every Codecaine and Lascari AI app: design tokens (CSS, Tailwind v4, JS, JSON), layout CSS and the style guide.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/js/index.d.ts",
      "default": "./dist/js/index.js"
    },
    "./fonts.css": {
      "style": "./css/fonts.css",
      "default": "./css/fonts.css"
    },
    "./fonts/*": "./fonts/*",
    "./tokens.css": {
      "style": "./dist/css/tokens.css",
      "default": "./dist/css/tokens.css"
    },
    "./tokens-dark-first.css": {
      "style": "./dist/css/tokens-dark-first.css",
      "default": "./dist/css/tokens-dark-first.css"
    },
    "./layout.css": {
      "style": "./css/layout.css",
      "default": "./css/layout.css"
    },
    "./host-contract.css": {
      "style": "./dist/css/host-contract.css",
      "default": "./dist/css/host-contract.css"
    },
    "./host-contract-dark-first.css": {
      "style": "./dist/css/host-contract-dark-first.css",
      "default": "./dist/css/host-contract-dark-first.css"
    },
    "./tailwind.css": {
      "style": "./dist/tailwind/theme.css",
      "default": "./dist/tailwind/theme.css"
    },
    "./tailwind-strict.css": {
      "style": "./dist/tailwind/strict.css",
      "default": "./dist/tailwind/strict.css"
    },
    "./tailwind-v3-preset": {
      "require": "./dist/tailwind/preset-v3.cjs",
      "default": "./dist/tailwind/preset-v3.cjs"
    },
    "./json/*": "./dist/json/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "css",
    "fonts",
    "tokens",
    "templates",
    "guide/*.md",
    "guide/app-shell-demo.html",
    "guide/screenshots",
    "AGENTS.md",
    "README.md"
  ],
  "scripts": {
    "build": "bun scripts/build.ts",
    "check": "bun scripts/build.ts --check",
    "test": "bun test ./test",
    "registry:check": "bun scripts/registry-check.ts",
    "lint:apps": "bun scripts/lint-apps.ts",
    "verify:apps": "bun scripts/verify-apps.ts",
    "snapshot": "bun scripts/snapshot.ts",
    "snapshot:diff": "bun scripts/snapshot-diff.ts",
    "snapshot:sheet": "bun scripts/snapshot-sheet.ts",
    "codemod:literals": "bun scripts/codemod-literals.ts",
    "progress": "bun scripts/progress.ts",
    "pack": "bun scripts/pack.ts",
    "test:apps": "bun scripts/test-apps.ts",
    "use:app": "bun scripts/use-app.ts",
    "design:score": "bun scripts/design-score/cli.ts",
    "prepack": "bun run build"
  },
  "publishConfig": {
    "access": "public"
  }
}
