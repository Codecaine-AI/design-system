    {
      "id": "workspace-full-send-loop",
      "server": "workspace",
      "app": "docs",
      "url": "/#/specs/20-fleet-setup/40-full-send-and-babysit-skills",
      "themes": ["light", "dark"],
      "steps": [
        {
          "action": "scroll",
          "selector": "[data-docs-scroller]",
          "top": 4300,
          "why": "process-outline with trace tags + titled warning callout"
        }
      ],
      "covers": "Workspace page in the app theme: process-outline (notes, keywords, trace tags), h2, titled warning callout"
    },
    {
      "id": "workspace-html-panel",
      "server": "workspace",
      "app": "docs",
      "url": "/#/specs/20-fleet-setup/50-theo-agent-fleet-reference",
      "themes": ["light", "dark"],
      "waitFor": ["[data-docs-block-type=\"html\"] iframe"],
      "steps": [
        {
          "action": "scroll",
          "selector": "[data-docs-scroller]",
          "top": 200,
          "why": "titled info callout + html panel head"
        }
      ],
      "masks": [
        {
          "selector": "[data-docs-block-type=\"html\"] dialog",
          "reason": "The html block's sandboxed iframe measures its own content and the panel scales it to fit; the measure races the frame's layout, so the scaled artifact (and the panel height, 604 or 659 px) differs between loads. The mask covers the artifact area; the panel head, border and everything above stay compared. Do not scroll past this block: everything below it shifts with the panel height."
        }
      ],
      "covers": "Workspace page: titled info callout, doc link chip, html panel head (sandbox label, Expand button); the artifact itself is masked"
    },
    {
      "id": "chrome-style-rail",
      "server": "docs-system",
      "app": "docs",
      "url": "/#/10-system-design/40-block-vocabulary/10-text-and-media/10-rich-text/14-callout",
      "themes": ["light", "dark"],
      "rail": "open",
      "railPane": "theme.colors",
      "covers": "Style rail open on the Colors pane (dark-mode switch, color swatches, nav, footer buttons); read only, nothing clicked"
    },
    {
      "id": "chrome-annotate-panel",
      "server": "docs-system",
      "app": "docs",
      "url": "/#/10-system-design/40-block-vocabulary/10-text-and-media/10-rich-text/14-callout",
      "themes": ["light", "dark"],
      "steps": [
        {
          "action": "click",
          "selector": "button[data-docs-lab-toggle]",
          "why": "Show AI panel: annotate mode + the floating glass panel"
        },
        {"action": "waitFor", "selector": "[data-lab-dock][data-lab-annotate-panel]"},
        {
          "action": "waitFor",
          "selector": "[data-docs-page-transition=\"idle\"][aria-busy=\"false\"] [data-docs-mode=\"annotate\"] [data-annotation-targeting=\"true\"]"
        },
        {
          "action": "hover",
          "selector": "[data-annotation-targeting=\"true\"] [data-block-id=\"b-15-callout-example-info-22\"]",
          "why": "targeting resolves the hovered block first; the hover ring proves its handlers are live"
        },
        {"action": "waitFor", "selector": "[data-annotation-ui=\"hover-ring\"]", "state": "attached"},
        {
          "action": "click",
          "selector": "[data-annotation-targeting=\"true\"] [data-block-id=\"b-15-callout-example-info-22\"]",
          "why": "target the info callout: selected ring + inline composer (nothing is filed until Enter)"
        },
        {"action": "waitFor", "selector": "[data-docs-inline-composer-anchor] [data-docs-lab-composer]"},
        {
          "action": "scroll",
          "selector": "[data-docs-scroller]",
          "top": 0,
          "why": "the composer's textarea.focus() sometimes centers it (scrolls ~80px) depending on layout timing; pin the scroll position"
        }
      ],
      "covers": "Annotate mode: glass AI panel (kernel shown 'not connected'), targeting ring, inline composer"
    },
    {
      "id": "chrome-export-dialog",
      "server": "docs-system",
      "app": "docs",
      "url": "/#/10-system-design/40-block-vocabulary/10-text-and-media/10-rich-text/14-callout",
      "themes": ["light", "dark"],
      "steps": [
        {
          "action": "click",
          "selector": "aside button:text-is(\"Export\")",
          "why": "opening fetches and writes nothing; only its Export button does"
        },
        {
          "action": "waitFor",
          "selector": "dialog[open]",
          "why": "the export dialog is the only modal; matched by state, not by its CSS class"
        }
      ],
      "covers": "Export dialog (modal, page checklist, select, buttons) over a dimmed page"
    },
    {
      "id": "chrome-side-peek",
      "server": "docs-system",
      "app": "docs",
      "url": "/#/00-foundation",
      "themes": ["light", "dark"],
      "steps": [
        {
          "action": "dispatch",
          "event": "spectre:doc-reference-navigate",
          "detail": {"ref": {"kind": "doc", "path": "00-foundation/00-manifesto"}, "intent": "peek"},
          "why": "the event a plain click on the Manifesto chip sends; dispatched so no pointer hover or node selection lands in the shot"
        },
        {
          "action": "waitFor",
          "selector": "aside[data-doc-peek-panel] [data-docs-page-transition=\"idle\"][aria-busy=\"false\"]"
        }
      ],
      "covers": "Side peek drawer showing another doc next to the page"
    },
    {
      "id": "chrome-link-editor",
      "server": "docs-system",
      "app": "docs",
      "url": "/#/10-system-design/40-block-vocabulary/10-text-and-media/10-rich-text/14-callout",
      "themes": ["light", "dark"],
      "steps": [
        {
          "action": "dblclick",
          "selector": "[data-doc-editor=\"true\"] p:has-text(\"Callout highlights short\")",
          "why": "select one word (a selection never dirties the doc)"
        },
        {
          "action": "press",
          "key": "Meta+k",
          "why": "Cmd+K opens the link popover; nothing changes until a link is applied"
        },
        {"action": "waitFor", "selector": "[data-doc-link-editor=\"true\"]"}
      ],
      "covers": "Editor link popover over a text selection (the app has no search or command palette; this is its only Cmd+K surface)"
    }
  ]
}
