    "p8c": {
      "id": "p8c",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "Cause",
          "attributes": {
            "bold": true
          }
        }
      ],
      "children": [
        "p8c1",
        "p8c2"
      ]
    },
    "p8c1": {
      "id": "p8c1",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "The headless shell draws WebGL with SwiftShader, a software renderer. The game took 14.4 to 15.3 s to show its start card, against the default 15 s wait."
        }
      ],
      "children": []
    },
    "p8c2": {
      "id": "p8c2",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "game-hud",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " and "
        },
        {
          "insert": "game-paused",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " also waited for "
        },
        {
          "insert": ".hud-overlay[data-mode=\"hidden\"]",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", which has "
        },
        {
          "insert": "visibility: hidden",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". A visible wait on it never resolves."
        }
      ],
      "children": []
    },
    "p8f": {
      "id": "p8f",
      "type": "list-item",
      "props": {},
      "text": [
