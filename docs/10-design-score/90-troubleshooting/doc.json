    "known-lead": {
      "id": "known-lead",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Nine problems came up during the first runs. Seven came up on Knowledge System on 2026-10-29, and two on tachyon-flow on 2026-10-30. Each heading names what you see."
        }
      ],
      "children": []
    },
    "h-p1": {
      "id": "h-p1",
      "type": "heading",
      "props": {
        "level": 3
      },
      "text": [
        {
          "insert": "The Report Names a Cached Chromium"
        }
      ],
      "children": []
    },
    "p1-what": {
      "id": "p1-what",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The provenance line in "
        },
        {
          "insert": "report.html",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " says that "
        },
        {
          "insert": "chromium_headless_shell-1243",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " is not installed and that the run uses the cached "
        },
        {
          "insert": "chromium_headless_shell-1234",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "."
        }
      ],
      "children": []
    },
    "p1c": {
      "id": "p1c",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "Cause",
          "attributes": {
            "bold": true
          }
        }
      ],
      "children": [
        "p1c1",
        "p1c2"
      ]
    },
    "p1c1": {
      "id": "p1c1",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "Core's Playwright wants headless shell r1243, but Playwright's browser cache holds only r1228 and r1234. On this Mac the cache is "
        },
        {
          "insert": "~/Library/Caches/ms-playwright/",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "."
        }
      ],
      "children": []
    },
    "p1c2": {
      "id": "p1c2",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "design:score",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " installs nothing. "
        },
        {
          "insert": "launch",
          "attributes": {
            "code": true,
            "reference": {
              "kind": "source",
              "path": "scripts/design-score/browser.ts",
              "symbol": "launch"
            }
          }
        },
        {
          "insert": " falls back to the newest cached shell, Chromium 151.0.7922.34."
        }
      ],
      "children": []
    },
    "p1f": {
      "id": "p1f",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "Fix",
          "attributes": {
            "bold": true
          }
        }
      ],
      "children": [
        "p1f1",
        "p1f2",
        "p1f3"
      ]
    },
    "p1f1": {
      "id": "p1f1",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "Compare only runs with the same "
        },
        {
          "insert": "provenance.browser.version",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " in "
        },
        {
          "insert": "scorecard.json",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". All runs on 2026-10-29 used r1234, so their deltas hold."
        }
      ],
      "children": []
    },
    "p1f2": {
      "id": "p1f2",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "To move to r1243, run "
        },
        {
          "insert": "bunx playwright install chromium-headless-shell",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " in "
        },
        {
          "insert": "codecaine/core",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". Then rerun both runs that you compare."
        }
      ],
      "children": []
    },
    "p1f3": {
      "id": "p1f3",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "On another platform, look in that platform's Playwright cache."
        }
      ],
      "children": [
        "p1f3a",
        "p1f3b"
      ]
    },
    "p1f3a": {
      "id": "p1f3a",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "Linux uses "
        },
        {
          "insert": "$XDG_CACHE_HOME/ms-playwright",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " or "
        },
        {
          "insert": "~/.cache/ms-playwright",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", and Windows uses "
        },
        {
          "insert": "%LOCALAPPDATA%\\ms-playwright",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "."
        }
      ],
      "children": []
    },
    "p1f3b": {
      "id": "p1f3b",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "PLAYWRIGHT_BROWSERS_PATH",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " replaces the cache on every platform."
        }
      ],
      "children": []
    },
