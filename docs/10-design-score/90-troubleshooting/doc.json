    "intro": {
      "id": "intro",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "This page lists the problems already seen in "
        },
        {
          "insert": "design:score",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " runs, each with its cause and its fix. The last section is a procedure for a check that acts strangely. Run the commands in the design-system checkout unless a step names another folder."
        }
      ],
      "children": []
    },
