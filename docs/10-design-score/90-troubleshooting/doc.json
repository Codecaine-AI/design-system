      "children": []
    },
    "p8f2": {
      "id": "p8f2",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "Use it only for a page that is slow in the scorer's headless browser and fast for a person. Give a whole number above 0, because Playwright reads 0 as no limit."
        }
      ],
      "children": []
    },
    "p8f3": {
      "id": "p8f3",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "Wait for an element that shows in the state. The game pages wait for "
