    "p8-what": {
      "id": "p8-what",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "tachyon-flow's game pages errored with \"waitForSelector: Timeout 15000ms exceeded\". With the Metal backend ("
        },
        {
          "insert": "--use-angle=metal",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "), the same start card shows in about 0.3 s."
        }
