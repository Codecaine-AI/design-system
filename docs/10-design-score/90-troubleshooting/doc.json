          "insert": "/Users/Ford/workspace/codebases/lascari-ai/knowledge-system/sample-knowledge",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", and no worktree copy of it."
        }
      ],
      "children": []
    },
    "p2c2": {
      "id": "p2c2",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "Only one server can run on a knowledge root. The server holds "
        },
        {
          "insert": "<root>/.index/ks-server.pid",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", and a second server refuses to start with \"Another Knowledge System server is already running\"."
