    "b1": {
      "id": "b1",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "R-min-font",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " finds visible text set under 12px. It is a runtime check in the typography area, so it runs in a browser on every page, theme and viewport. Text under 12px fails, and an uppercase label from 10px up to 12px only warns."
        }
      ],
      "children": []
    },
    "b2": {
      "id": "b2",
      "type": "heading",
      "props": {
        "level": 2
