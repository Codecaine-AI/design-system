      "id": "b3",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The check reads the computed "
        },
        {
          "insert": "font-size",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " of each visible text element and reports three cases."
        }
      ],
      "children": []
