      ]
    },
    "b35": {
      "id": "b35",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "A year, a version such as 2.4 or a page number does not change in place. The check still warns when the digits are proportional."
        }
      ],
      "children": []
    },
    "b36": {
      "id": "b36",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "Numbers in a sentence",
          "attributes": {
            "bold": true
          }
