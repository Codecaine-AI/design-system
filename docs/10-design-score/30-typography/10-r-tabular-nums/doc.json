    "b31": {
      "id": "b31",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The probe never reads "
        },
        {
          "insert": "text-align",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", so a left-aligned number column passes. "
        },
        {
          "insert": "typo-tabular-nums",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " keeps prose figures proportional, and the check meets that part by skipping any text with a letter."
        }
      ],
      "children": []
    },
    "b32": {
      "id": "b32",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "Known False Positives"
