      "children": []
    },
    "b33": {
      "id": "b33",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The check sees the characters, not what the number means."
        }
      ],
      "children": []
    },
    "b34": {
      "id": "b34",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "Numbers that never change",
          "attributes": {
