    "b1": {
      "id": "b1",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "R-tabular-nums",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " finds number text set with proportional digits, so a column of numbers drifts as its digits change. It is a runtime check in the typography area, so it runs in a browser on every page, theme and viewport. Each finding warns and never fails the page."
        }
      ],
      "children": []
    },
    "b2": {
      "id": "b2",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "What It Catches"
        }
      ],
      "children": []
    },
    "b3": {
      "id": "b3",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The check reports a text element that holds only a number and uses proportional digits."
        }
      ],
      "children": []
    },
    "b4": {
      "id": "b4",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "Number-only text",
          "attributes": {
            "bold": true
          }
        }
      ],
      "children": [
        "b5"
      ]
    },
    "b5": {
      "id": "b5",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "The element's own text holds 2 digits or more, and no character other than digits, spaces and "
        },
        {
          "insert": ". , : % + - − – / $ € £ ×",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "."
        }
      ],
      "children": []
    },
    "b6": {
      "id": "b6",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "Proportional digits",
          "attributes": {
            "bold": true
          }
        }
      ],
      "children": [
        "b7"
      ]
    },
    "b7": {
      "id": "b7",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "Its computed "
        },
        {
          "insert": "font-variant-numeric",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " has no "
        },
        {
          "insert": "tabular-nums",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", and its "
        },
        {
          "insert": "font-feature-settings",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " has no "
        },
        {
          "insert": "tnum",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "."
        }
      ],
      "children": []
    },
    "b8": {
      "id": "b8",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "Not reported",
          "attributes": {
            "bold": true
          }
        }
      ],
      "children": [
        "b9",
        "b10"
      ]
    },
    "b9": {
      "id": "b9",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "A font family whose name contains \"mono\" already has digits of one width, so the check skips it."
        }
      ],
      "children": []
    },
    "b10": {
      "id": "b10",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "Text with a letter in it, such as \"3 files\", counts as prose and keeps proportional digits."
        }
      ],
      "children": []
    },
    "b11": {
      "id": "b11",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "How It Measures"
        }
      ],
      "children": []
    },
    "b12": {
      "id": "b12",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The probe runs inside the page and reads each element's styles with "
        },
        {
          "insert": "getComputedStyle",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". It takes these steps in order."
        }
      ],
      "children": []
    },
    "b13": {
      "id": "b13",
      "type": "list-item",
      "props": {
        "ordered": true
      },
      "text": [
        {
          "insert": "scripts/design-score/run.ts",
          "attributes": {
            "code": true,
            "reference": {
              "kind": "source",
              "path": "scripts/design-score/run.ts",
              "symbol": "runScore"
            }
          }
        },
        {
          "insert": " calls "
        },
        {
          "insert": "probePage",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " once per theme and viewport, after the page's actions and settle time."
        }
      ],
      "children": []
    },
    "b14": {
      "id": "b14",
      "type": "list-item",
      "props": {
        "ordered": true
      },
      "text": [
        {
          "insert": "probePage",
          "attributes": {
            "code": true,
            "reference": {
              "kind": "source",
              "path": "scripts/design-score/probes.ts",
              "symbol": "textEls"
            }
          }
        },
        {
          "insert": " collects each visible text element that has its own text node. It drops an element whose first line is more than half hidden by a clipping ancestor."
        }
      ],
      "children": []
    },
    "b15": {
      "id": "b15",
      "type": "list-item",
      "props": {
        "ordered": true
      },
      "text": [
        {
          "insert": "The tabular pass",
          "attributes": {
            "reference": {
              "kind": "source",
              "path": "scripts/design-score/probes.ts",
              "symbol": "R-tabular-nums"
            }
          }
        },
        {
          "insert": " joins the element's own text nodes and tests the result against the number pattern."
        }
      ],
      "children": []
    },
    "b16": {
      "id": "b16",
      "type": "list-item",
      "props": {
        "ordered": true
      },
      "text": [
        {
          "insert": "The pass reads "
        },
        {
          "insert": "font-variant-numeric",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", "
        },
        {
          "insert": "font-feature-settings",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " and "
        },
        {
          "insert": "font-family",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", and skips an element that already has digits of one width."
        }
      ],
      "children": []
    },
    "b17": {
      "id": "b17",
      "type": "list-item",
      "props": {
        "ordered": true
      },
      "text": [
        {
          "insert": "The pass reports what is left as a warn finding, with the text and its "
        },
        {
          "insert": "font-variant-numeric",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " value."
        }
      ],
      "children": []
    },
    "b18": {
      "id": "b18",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Each finding has a key made from the element's class signature: its tag and first 2 classes, and those of 2 parents. Number cells with the same classes report once."
        }
      ],
      "children": []
    },
    "b19": {
      "id": "b19",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "Thresholds"
        }
      ],
      "children": []
    },
    "b20": {
      "id": "b20",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The check has no distance or size limit. It tests the text and 3 computed styles."
        }
      ],
      "children": []
    },
