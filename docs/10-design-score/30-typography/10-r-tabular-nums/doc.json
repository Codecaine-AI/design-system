      "children": [
        "b37"
      ]
    },
    "b37": {
      "id": "b37",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "A number in its own "
        },
        {
          "insert": "span",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " inside a sentence counts as number-only text. The rule wants that figure to stay proportional."
        }
      ],
      "children": []
    },
    "b38": {
