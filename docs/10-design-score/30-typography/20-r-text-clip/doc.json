    "b13": {
      "id": "b13",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The probe measures text with "
        },
        {
          "insert": "Range.getClientRects",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", which gives one rect per line of text. It takes these steps in order."
        }
      ],
      "children": []
    },
    "b14": {
      "id": "b14",
      "type": "list-item",
      "props": {
        "ordered": true
      },
      "text": [
        {
          "insert": "scripts/design-score/run.ts",
          "attributes": {
            "code": true,
            "reference": {
              "kind": "source",
              "path": "scripts/design-score/run.ts",
              "symbol": "runScore"
            }
          }
        },
        {
          "insert": " calls "
        },
        {
          "insert": "probePage",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " once per theme and viewport, after the page's actions and settle time."
        }
      ],
      "children": []
    },
    "b15": {
      "id": "b15",
      "type": "list-item",
      "props": {
        "ordered": true
      },
      "text": [
        {
          "insert": "probePage",
          "attributes": {
            "code": true,
            "reference": {
              "kind": "source",
              "path": "scripts/design-score/probes.ts",
              "symbol": "textEls"
            }
          }
        },
        {
          "insert": " collects each visible text element that has its own text node. It drops an element whose first line is more than half hidden by a clipping ancestor."
        }
      ],
      "children": []
    },
    "b16": {
      "id": "b16",
      "type": "list-item",
      "props": {
        "ordered": true
      },
      "text": [
        {
          "insert": "The clip pass",
          "attributes": {
            "reference": {
              "kind": "source",
              "path": "scripts/design-score/probes.ts",
              "symbol": "R-text-clip"
            }
          }
        },
        {
          "insert": " takes the right-most and bottom-most edges of the element's text rects."
        }
      ],
      "children": []
    },
    "b17": {
      "id": "b17",
      "type": "list-item",
      "props": {
        "ordered": true
      },
      "text": [
        {
          "insert": "The pass walks up from the element itself, at most 4 levels. A scroller on the way can cap how far the text reaches, as Boxes on the Walk shows."
        }
      ],
      "children": []
    },
    "b18": {
      "id": "b18",
      "type": "list-item",
      "props": {
        "ordered": true
      },
      "text": [
        {
          "insert": "At a box whose overflow is "
        },
        {
          "insert": "hidden",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " or "
        },
        {
          "insert": "clip",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", the pass compares the text edges with the box's edges inside its border. It reports a right cut first, and a bottom cut only when there is no right cut."
        }
      ],
      "children": []
    },
    "b19": {
      "id": "b19",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The first clip box that cuts the text ends the walk, with or without a finding. A box 2px wide or tall, or less, is a screen-reader-only box, and the walk stops there without a finding."
        }
      ],
      "children": []
    },
    "b20": {
      "id": "b20",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Each finding has a key made from the element's class signature, with "
        },
        {
          "insert": "|y",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " added for a bottom cut. A component reports each kind of cut once."
        }
      ],
      "children": []
    },
    "walk-h": {
      "id": "walk-h",
      "type": "heading",
      "props": {
        "level": 3
      },
      "text": [
        {
          "insert": "Boxes on the Walk"
        }
      ],
      "children": []
    },
    "walk-lead": {
      "id": "walk-lead",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Not every box above the text can cut it. The pass treats three kinds of box in their own way."
        }
      ],
      "children": []
    },
    "walk1": {
      "id": "walk1",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "Scrollers",
          "attributes": {
            "bold": true
          }
        }
      ],
      "children": [
        "walk1a",
        "walk1b",
        "walk1c",
        "walk1d",
        "walk1e"
      ]
    },
    "walk1a": {
      "id": "walk1a",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "A box scrolls on an axis when its overflow on that axis is "
        },
        {
          "insert": "auto",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " or "
        },
        {
          "insert": "scroll",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". An "
        },
        {
          "insert": "inline",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " or "
        },
        {
          "insert": "display: contents",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " box never scrolls, because overflow does not apply to it."
        }
      ],
      "children": []
    },
    "walk1b": {
      "id": "walk1b",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "When the text runs past the scroller's visible edge, the pass caps the text's reach at that edge. A clip box above the scroller then fails the text only when it hides part of the scroller."
        }
      ],
      "children": []
    },
    "walk1c": {
      "id": "walk1c",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "The pass scales the visible edge by the scroller's rect over its offset size, so a transformed scroller counts where it shows."
        }
      ],
      "children": []
    },
    "walk1d": {
      "id": "walk1d",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "The cap applies only to text that scrolling can reach. A "
        },
        {
          "insert": "column-reverse",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " box overflows the wrong way, so its text keeps its full reach and the box above can cut it."
        }
      ],
      "children": []
    },
    "walk1e": {
      "id": "walk1e",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "A finding after a cap says \"a scroller holding this text runs Npx past the right edge\", or \"below the bottom\", of the clip box."
        }
      ],
      "children": []
    },
    "walk2": {
      "id": "walk2",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "Clip boxes that cut nothing",
          "attributes": {
            "bold": true
