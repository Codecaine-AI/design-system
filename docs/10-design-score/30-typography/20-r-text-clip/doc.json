    "b1": {
      "id": "b1",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "R-text-clip",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " finds text that a box cuts off with no sign that text is missing. It is a runtime check in the typography area, so it runs in a browser on every page, theme and viewport. Each finding fails the page."
        }
      ],
      "children": []
    },
    "b2": {
      "id": "b2",
      "type": "heading",
      "props": {
        "level": 2
      },
