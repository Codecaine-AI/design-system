      "children": []
    },
    "b3": {
      "id": "b3",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The check reports two kinds of cut. An ellipsis or a line clamp shows the reader that text is missing, so the check passes a cut that has one."
        }
      ],
      "children": []
    },
    "b4": {
      "id": "b4",
      "type": "list-item",
      "props": {},
      "text": [
