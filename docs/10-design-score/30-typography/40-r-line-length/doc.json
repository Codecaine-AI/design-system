    "b1": {
      "id": "b1",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "R-line-length",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " finds wrapped prose whose lines hold more than 80 characters. It is a runtime check in the typography area, so it runs in a browser on every page, theme and viewport. Each finding warns and never fails the page."
        }
      ],
      "children": []
    },
    "b2": {
      "id": "b2",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "What It Catches"
        }
      ],
      "children": []
    },
    "b3": {
      "id": "b3",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The check reports a block of wrapped prose whose lines are too long for the eye to find the start of the next line."
        }
      ],
      "children": []
    },
    "b4": {
      "id": "b4",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "Wrapped prose",
          "attributes": {
            "bold": true
          }
        }
      ],
      "children": [
        "b5"
      ]
    },
    "b5": {
      "id": "b5",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "The element is not "
        },
        {
          "insert": "display: inline",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", its own text sits on 2 lines or more, and its full text holds 120 characters or more."
        }
      ],
      "children": []
    },
    "b6": {
      "id": "b6",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "Too many characters per line",
          "attributes": {
            "bold": true
          }
        }
      ],
      "children": [
        "b7"
      ]
    },
    "b7": {
      "id": "b7",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "Its content width holds more than 80 average characters of its own font."
        }
      ],
      "children": []
    },
    "b8": {
      "id": "b8",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "Not reported",
          "attributes": {
            "bold": true
          }
        }
      ],
      "children": [
        "b9"
      ]
    },
    "b9": {
      "id": "b9",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "Monospace text and text inside "
        },
        {
          "insert": "pre",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", "
        },
        {
          "insert": "code",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " or "
        },
        {
          "insert": "table",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " are skipped, because code and data tables set their own widths."
        }
      ],
      "children": []
    },
    "b10": {
      "id": "b10",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "How It Measures"
        }
      ],
      "children": []
    },
    "b11": {
      "id": "b11",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The probe estimates the characters per line from the font and the box width. It does not count the characters on a rendered line. It takes these steps in order."
        }
      ],
      "children": []
    },
    "b12": {
      "id": "b12",
      "type": "list-item",
      "props": {
        "ordered": true
      },
      "text": [
        {
          "insert": "scripts/design-score/run.ts",
          "attributes": {
            "code": true,
            "reference": {
              "kind": "source",
              "path": "scripts/design-score/run.ts",
              "symbol": "runScore"
            }
          }
        },
        {
          "insert": " calls "
        },
        {
          "insert": "probePage",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " once per theme and viewport, after the page's actions and settle time."
        }
      ],
      "children": []
    },
    "b13": {
      "id": "b13",
      "type": "list-item",
      "props": {
        "ordered": true
      },
      "text": [
        {
          "insert": "probePage",
          "attributes": {
            "code": true,
            "reference": {
              "kind": "source",
              "path": "scripts/design-score/probes.ts",
              "symbol": "textEls"
            }
          }
        },
        {
          "insert": " collects each visible text element that has its own text node. It drops an element whose first line is more than half hidden by a clipping ancestor."
        }
      ],
      "children": []
    },
    "b14": {
      "id": "b14",
      "type": "list-item",
      "props": {
        "ordered": true
      },
      "text": [
        {
          "insert": "The line pass",
          "attributes": {
            "reference": {
              "kind": "source",
              "path": "scripts/design-score/probes.ts",
              "symbol": "R-line-length"
            }
          }
        },
        {
          "insert": " counts the distinct tops of the element's own text rects, and skips an element with fewer than 2 lines."
        }
      ],
      "children": []
    },
    "b15": {
      "id": "b15",
      "type": "list-item",
      "props": {
        "ordered": true
      },
      "text": [
        {
          "insert": "The pass sets a canvas 2D context to the element's font and measures the first 400 characters of its text. The width divided by the character count is the average character width."
        }
      ],
      "children": []
    },
    "b16": {
      "id": "b16",
      "type": "list-item",
      "props": {
        "ordered": true
      },
      "text": [
        {
          "insert": "The pass divides the content width, the box width less padding and borders, by that average character width."
        }
      ],
      "children": []
    },
    "b17": {
      "id": "b17",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Each finding has a key made from the element's class signature, so paragraphs with the same classes report once."
        }
      ],
      "children": []
    },
    "b18": {
      "id": "b18",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "Thresholds"
        }
      ],
      "children": []
    },
    "b19": {
      "id": "b19",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "A text must pass three gates before the check measures it. The limit is in average characters of the text's own font."
        }
      ],
      "children": []
    },
