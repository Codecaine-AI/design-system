    "b21": {
      "id": "b21",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "typo-measure",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " asks for 60 to 75 characters. The check warns only above 80, so a line of 76 to 80 characters passes."
        }
      ],
      "children": []
    },
