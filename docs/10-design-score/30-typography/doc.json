      "id": "intro",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The typography checks measure rendered text: number alignment, clipped text, font size and line length. They run in a browser on every page, theme and viewport. The area has 4 runtime checks and 44 rules in "
        },
        {
          "insert": "design-score/rules/typography.json",
          "attributes": {
            "code": true,
            "reference": {
              "kind": "source",
              "path": "design-score/rules/typography.json"
            }
          }
        },
        {
          "insert": "."
        }
      ],
      "children": []
    },
