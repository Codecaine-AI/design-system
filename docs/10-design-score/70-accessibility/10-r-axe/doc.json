    "m-lead": {
      "id": "m-lead",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The design system does not ship axe-core, so the run finds a copy first. It takes these steps in order."
        }
      ],
      "children": []
    },
    "m1": {
      "id": "m1",
      "type": "list-item",
      "props": {
        "ordered": true
      },
      "text": [
        {
          "insert": "findAxe",
          "attributes": {
            "code": true,
            "reference": {
              "kind": "source",
              "path": "scripts/design-score/browser.ts",
              "symbol": "findAxe"
            }
          }
        },
        {
          "insert": " reads "
        },
        {
          "insert": "axe.min.js",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " from "
        },
        {
          "insert": "DS_AXE_PATH",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", else from Core's node_modules, else from a known copy in the workspace. With no copy, R-axe is n/a."
        }
      ],
      "children": []
    },
    "m2": {
      "id": "m2",
      "type": "list-item",
      "props": {
        "ordered": true
      },
      "text": [
        {
          "insert": "scripts/design-score/run.ts",
          "attributes": {
            "code": true,
            "reference": {
              "kind": "source",
              "path": "scripts/design-score/run.ts",
              "symbol": "runScore"
            }
          }
        },
        {
          "insert": " calls "
        },
        {
          "insert": "runAxe",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " once per theme and viewport, after the probes."
        }
      ],
      "children": []
    },
    "m3": {
      "id": "m3",
      "type": "list-item",
      "props": {
        "ordered": true
      },
      "text": [
        {
          "insert": "runAxe",
          "attributes": {
            "code": true,
            "reference": {
              "kind": "source",
              "path": "scripts/design-score/axe.ts",
              "symbol": "runAxe"
            }
          }
        },
        {
          "insert": " injects axe-core once per page and runs it on the document. It excludes the app config's "
        },
        {
          "insert": "ignore",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " selectors."
        }
      ],
      "children": []
    },
    "m4": {
      "id": "m4",
      "type": "list-item",
      "props": {
        "ordered": true
      },
      "text": [
        {
          "insert": "The run uses only the rules with the "
        },
        {
          "insert": "five WCAG tags",
          "attributes": {
            "reference": {
              "kind": "source",
              "path": "scripts/design-score/axe.ts",
              "symbol": "TAGS"
            }
          }
        },
        {
          "insert": ". It turns off "
        },
        {
          "insert": "color-contrast",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " and "
        },
        {
          "insert": "target-size",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", because R-contrast and R-hit-target own them."
        }
      ],
      "children": []
    },
    "m5": {
      "id": "m5",
      "type": "list-item",
      "props": {
        "ordered": true
      },
      "text": [
        {
          "insert": "Each violation node becomes a finding, up to 8 nodes per rule. axe's "
        },
        {
          "insert": "incomplete",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " results are dropped."
