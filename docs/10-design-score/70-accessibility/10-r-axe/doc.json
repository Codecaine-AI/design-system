    "intro": {
      "id": "intro",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "R-axe",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " runs the axe-core accessibility engine on each page and reports its WCAG 2.2 AA violations. It is a runtime check in the accessibility area, so it runs in a browser on every page, theme and viewport. Every violation fails the page."
        }
      ],
      "children": []
    },
