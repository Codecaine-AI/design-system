    "intro": {
      "id": "intro",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The accessibility checks run axe-core on each page and tab through its controls to see that focus shows. The area has 2 runtime checks and 56 rules in "
        },
        {
          "insert": "design-score/rules/accessibility.json",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "."
        }
      ],
      "children": []
    },
