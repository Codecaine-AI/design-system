        }
      ],
      "children": []
    },
    "checks-lead": {
      "id": "checks-lead",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Each check has its own page with its thresholds, a good and bad fixture pair and its known false positives. Both are runtime checks, and both fail the page."
        }
      ],
      "children": []
    },
