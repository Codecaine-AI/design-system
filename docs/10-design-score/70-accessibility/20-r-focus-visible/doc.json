    "intro": {
      "id": "intro",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "R-focus-visible",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " presses Tab through each page and checks that every focused control changes the pixels around it. It is a runtime check in the accessibility area. It runs in every theme, in the first viewport only. A control that shows no change on keyboard focus fails the page."
        }
      ],
      "children": []
    },
    "h-catches": {
      "id": "h-catches",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "What It Catches"
        }
      ],
      "children": []
    },
    "catches-lead": {
      "id": "catches-lead",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The check reports keyboard focus that a sighted user cannot see. It compares screenshots, so it does not care how the indicator is drawn."
        }
      ],
      "children": []
    },
    "c1": {
      "id": "c1",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "A removed outline",
          "attributes": {
            "bold": true
          }
        }
      ],
      "children": [
        "c1a"
      ]
    },
    "c1a": {
      "id": "c1a",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "outline: none",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " on "
        },
        {
          "insert": ":focus",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " with nothing in its place fails at every control it matches."
        }
      ],
      "children": []
    },
    "c2": {
      "id": "c2",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "A ring that the theme hides",
          "attributes": {
            "bold": true
          }
        }
      ],
      "children": [
        "c2a"
      ]
    },
    "c2a": {
      "id": "c2a",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "A ring color that is too close to the surface in one theme changes too few pixels, so that theme fails."
        }
      ],
      "children": []
    },
    "c3": {
      "id": "c3",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "Any indicator counts",
          "attributes": {
            "bold": true
          }
        }
      ],
      "children": [
        "c3a"
      ]
    },
    "c3a": {
      "id": "c3a",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "An outline, a box-shadow ring, a border color or a background change passes when it changes enough pixels near the control. A ring that the control's own stretched "
        },
        {
          "insert": "::after",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " draws over its tile also counts."
        }
      ],
      "children": []
    },
    "h-measures": {
      "id": "h-measures",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "How It Measures"
        }
      ],
      "children": []
    },
    "m-lead": {
      "id": "m-lead",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The focus pass drives the real keyboard in Chromium. It takes these steps in order."
        }
      ],
      "children": []
    },
    "m1": {
      "id": "m1",
      "type": "list-item",
      "props": {
        "ordered": true
      },
      "text": [
        {
          "insert": "scripts/design-score/run.ts",
          "attributes": {
            "code": true,
            "reference": {
              "kind": "source",
              "path": "scripts/design-score/run.ts",
              "symbol": "Focus"
            }
          }
        },
        {
          "insert": " calls "
        },
        {
          "insert": "focusPass",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " once per theme, in the first viewport, after the probes and axe."
        }
      ],
      "children": []
    },
    "m2": {
      "id": "m2",
      "type": "list-item",
      "props": {
        "ordered": true
      },
      "text": [
        {
          "insert": "focusPass",
          "attributes": {
            "code": true,
            "reference": {
              "kind": "source",
              "path": "scripts/design-score/focus.ts",
              "symbol": "focusPass"
            }
          }
        },
        {
          "insert": " turns off transitions, animations and smooth scrolling, and focuses the body so that the first Tab starts at the top."
        }
      ],
      "children": []
    },
    "m3": {
      "id": "m3",
      "type": "list-item",
      "props": {
        "ordered": true
      },
      "text": [
        {
          "insert": "For each Tab stop, the pass screenshots a clip of the control plus 6px on each side, while the control has focus."
        }
      ],
      "children": []
    },
    "m4": {
      "id": "m4",
      "type": "list-item",
      "props": {
        "ordered": true
      },
      "text": [
        {
          "insert": "The pass blurs the control and screenshots the same clip again, with nothing focused. "
        },
        {
          "insert": "changedPixels",
          "attributes": {
            "code": true,
            "reference": {
              "kind": "source",
              "path": "scripts/design-score/focus.ts",
              "symbol": "changedPixels"
            }
          }
        },
        {
          "insert": " counts the pixels that differ between the two clips."
        }
      ],
      "children": []
    },
    "m5": {
      "id": "m5",
      "type": "list-item",
      "props": {
        "ordered": true
      },
      "text": [
        {
          "insert": "A stop with too few changed pixels is a finding. The pass keeps a crop of the focused clip for the report, then focuses the control again and presses Tab from it."
        }
      ],
      "children": []
    },
    "m-own": {
      "id": "m-own",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The clip also covers the control's own "
        },
        {
          "insert": "::before",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " and "
        },
        {
          "insert": "::after",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " when either is shown and "
        },
        {
          "insert": "absolute",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " or "
        },
        {
          "insert": "fixed",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". "
        },
        {
          "insert": "ownPaintBox",
          "attributes": {
            "code": true,
            "reference": {
              "kind": "source",
              "path": "scripts/design-score/focus.ts",
              "symbol": "ownPaintBox"
            }
          }
        },
        {
          "insert": " reads their boxes from Chromium's layout through CDP "
        },
        {
          "insert": "DOM.getBoxModel",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", so a "
        },
        {
          "insert": "::after",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " stretched over a tile widens the clip to the tile. For a Tab stop on a shadow host, the pass follows "
        },
        {
          "insert": "shadowRoot.activeElement",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " through open shadow roots to the focused control."
        }
      ],
      "children": []
    },
    "m-moved": {
      "id": "m-moved",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The control can move between the two clips. When the control moved, the pass reads the computed style instead. A set outline or a changed box-shadow then counts as visible."
        }
      ],
      "children": []
    },
    "m-stop": {
      "id": "m-stop",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The pass stops after 30 Tab stops, when focus cycles back to the first stop, or when focus leaves the page. It also stops at an iframe or a contenteditable element, because Tab can edit text there."
        }
      ],
      "children": []
    },
    "h-thresholds": {
      "id": "h-thresholds",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "Thresholds"
        }
      ],
      "children": []
    },
    "t-lead": {
      "id": "t-lead",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "A pixel counts as changed when one color channel moves by more than 24 of 255. The number of changed pixels needed grows with the control's size."
        }
      ],
      "children": []
    },
