      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Each check has its own page with its thresholds, a good and bad fixture pair and its known false positives. R-contrast runs its fixture in light and dark, because a color pair can pass in one theme and fail in the other."
        }
      ],
      "children": []
    },
