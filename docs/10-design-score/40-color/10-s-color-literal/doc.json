      ],
      "children": []
    },
    "m3": {
      "id": "m3",
      "type": "list-item",
      "props": {
        "ordered": true
      },
      "text": [
        {
          "insert": "scan-literals strips comments and matches each color literal. It marks a literal in a definition ("
        },
        {
          "insert": "inDefinition",
          "attributes": {
            "code": true,
            "reference": {
              "kind": "source",
              "path": "scripts/scan-literals.ts",
              "symbol": "inDefinition"
            }
          }
        },
        {
          "insert": ") and a literal in a fallback ("
        },
        {
          "insert": "varFallbackMask",
          "attributes": {
            "code": true,
            "reference": {
              "kind": "source",
              "path": "scripts/scan-literals.ts",
              "symbol": "varFallbackMask"
            }
          }
        },
        {
          "insert": ")."
        }
      ],
      "children": []
    },
    "m4": {
      "id": "m4",
      "type": "list-item",
      "props": {
        "ordered": true
      },
      "text": [
        {
          "insert": "The S-color-literal pass",
          "attributes": {
            "reference": {
              "kind": "source",
              "path": "scripts/design-score/static-checks.ts",
              "symbol": "S-color-literal"
            }
          }
        },
        {
          "insert": " keeps the hits in "
        },
        {
          "insert": "COLOR_CATEGORIES",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " and the Tailwind arbitrary values that hold a color. It drops every fallback."
