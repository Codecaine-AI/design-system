    "intro": {
      "id": "intro",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "S-color-literal",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " finds hard-coded colors in an app's source files. It is a static check in the color area, so it reads files with no browser, and its result counts once on every page. An inline literal fails the page, and a literal in a custom-property definition warns."
        }
      ],
      "children": []
    },
