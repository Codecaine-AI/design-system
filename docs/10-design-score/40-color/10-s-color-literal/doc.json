      ],
      "children": []
    },
    "catches-lead": {
      "id": "catches-lead",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The check sorts each color literal by where it sits. A literal behind a token is ignored, and some soft hits are not counted."
        }
      ],
      "children": []
    },
