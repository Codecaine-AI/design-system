        {
          "insert": "runStaticChecks",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " once per run, with the app config's "
        },
        {
          "insert": "sourceDirs",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " and "
        },
