    "intro": {
      "id": "intro",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "R-contrast",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " measures the contrast of each visible text against the color painted under it. It is a runtime check in the color area, so it runs in a browser on every page, theme and viewport. Text under 4.5:1, or under 3:1 for large text, fails the page."
        }
      ],
      "children": []
    },
    "h-catches": {
      "id": "h-catches",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "What It Catches"
        }
      ],
      "children": []
    },
    "catches-lead": {
      "id": "catches-lead",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The check reports text that is too faint for its background. It reads the colors the browser paints, so it catches problems that a token review misses."
        }
      ],
      "children": []
    },
    "c1": {
      "id": "c1",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "Faint text",
          "attributes": {
            "bold": true
          }
        }
      ],
      "children": [
        "c1a"
      ]
    },
    "c1a": {
      "id": "c1a",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "A muted or faint token on a light surface, such as "
        },
        {
          "insert": "--ds-color-text-faint",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " on the panel, gives 2.65:1 in light."
        }
      ],
      "children": []
    },
    "c2": {
      "id": "c2",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "The wrong glyph color on a tile",
          "attributes": {
            "bold": true
          }
        }
