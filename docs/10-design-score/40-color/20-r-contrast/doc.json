    "r-gap": {
      "id": "r-gap",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The probe measures text only, with WCAG 2 ratios. It does not measure focus rings, control borders, icons or APCA values. It skips disabled text, and a placeholder is not a text node, so neither gets a finding."
        }
