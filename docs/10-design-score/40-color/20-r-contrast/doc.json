      "children": [
        "c2a"
      ]
    },
    "c2a": {
      "id": "c2a",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "--ds-color-text-on-solid",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " on the yellow tile gives 2.11:1 in light. The tile's own "
        },
        {
          "insert": "--ds-color-yellow-on-solid",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " passes."
        }
      ],
      "children": []
    },
    "c3": {
      "id": "c3",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "One theme only",
          "attributes": {
            "bold": true
          }
        }
      ],
      "children": [
        "c3a"
      ]
    },
    "c3a": {
      "id": "c3a",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "A pair can pass in one theme and fail in the other. The check measures each theme in the app config on its own."
        }
      ],
      "children": []
    },
    "c4": {
      "id": "c4",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "Translucent layers",
          "attributes": {
            "bold": true
          }
        }
      ],
      "children": [
        "c4a"
      ]
    },
    "c4a": {
      "id": "c4a",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "A text color or a background with alpha is composited over the layers under it, so a translucent surface counts as the color it shows."
        }
      ],
      "children": []
    },
    "h-measures": {
      "id": "h-measures",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "How It Measures"
        }
      ],
      "children": []
    },
    "m-lead": {
      "id": "m-lead",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The probe runs inside the page and reads computed colors. It takes these steps in order."
        }
      ],
      "children": []
    },
    "m1": {
      "id": "m1",
      "type": "list-item",
      "props": {
        "ordered": true
      },
      "text": [
        {
          "insert": "scripts/design-score/run.ts",
          "attributes": {
            "code": true,
            "reference": {
              "kind": "source",
              "path": "scripts/design-score/run.ts",
              "symbol": "runScore"
            }
          }
        },
        {
          "insert": " calls "
        },
        {
          "insert": "probePage",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " once per theme and viewport, after the page's actions and settle time."
        }
      ],
      "children": []
    },
    "m2": {
      "id": "m2",
      "type": "list-item",
      "props": {
        "ordered": true
      },
      "text": [
        {
          "insert": "probePage",
          "attributes": {
            "code": true,
            "reference": {
              "kind": "source",
              "path": "scripts/design-score/probes.ts",
              "symbol": "textEls"
            }
          }
        },
        {
          "insert": " collects each visible element that holds its own text nodes. It drops screen-reader-only text and text that its box clips."
        }
      ],
      "children": []
    },
    "m3": {
      "id": "m3",
      "type": "list-item",
      "props": {
        "ordered": true
      },
      "text": [
        {
          "insert": "The contrast pass",
          "attributes": {
            "reference": {
              "kind": "source",
              "path": "scripts/design-score/probes.ts",
              "symbol": "R-contrast"
            }
          }
        },
        {
          "insert": " takes a point on the first line, 8px in from its left edge, and reads the element stack there with "
        },
        {
          "insert": "elementsFromPoint",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "."
        }
      ],
      "children": []
    },
    "m4": {
      "id": "m4",
      "type": "list-item",
      "props": {
        "ordered": true
      },
      "text": [
        {
          "insert": "The pass collects each background color from the text down to the first opaque one, and composites them over white. It multiplies the text alpha by every ancestor's opacity."
        }
      ],
      "children": []
    },
    "m5": {
      "id": "m5",
      "type": "list-item",
      "props": {
        "ordered": true
      },
      "text": [
        {
          "insert": "The pass computes the WCAG 2 contrast ratio of the composited text color and background with "
        },
        {
          "insert": "ratio",
          "attributes": {
            "code": true,
            "reference": {
              "kind": "source",
              "path": "scripts/design-score/probes.ts",
              "symbol": "ratio"
            }
          }
        },
        {
          "insert": "."
        }
      ],
      "children": []
    },
    "m-skip": {
      "id": "m-skip",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The pass skips text it cannot measure. Text inside an svg, disabled text, gradient text and text with a blend mode are skipped. Text over an image, a video, a canvas, an iframe, a background image or a backdrop filter is also skipped."
        }
      ],
      "children": []
    },
    "m-key": {
      "id": "m-key",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Each finding has a key made from the text color, the background and the class signature. Repeated rows with the same colors report once per component."
        }
      ],
      "children": []
    },
    "h-thresholds": {
      "id": "h-thresholds",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "Thresholds"
