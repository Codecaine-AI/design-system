      "children": []
    },
    "t-lead": {
      "id": "t-lead",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The required ratio depends on the computed font size and weight. A ratio must be under the threshold by more than 0.005 to fail."
        }
      ],
      "children": []
    },
