    "b1": {
      "id": "b1",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "design:score",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " scores every page of an app against the design rules in a real browser. It runs 24 checks, and each check belongs to one area and one layer. Each check has its own page that explains what it measures and shows a good and a bad example. Each example pair is also a test that the check must pass."
        }
      ],
      "children": []
    },
    "b1-guides": {
      "id": "b1-guides",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Start with "
        },
        {
          "insert": "Run and Read a Score",
          "attributes": {
            "reference": {
              "kind": "doc",
              "path": "10-design-score/10-run-and-read"
            }
          }
        },
        {
          "insert": " for the commands, the report and the hill-climb loop. "
        },
        {
          "insert": "Troubleshooting",
          "attributes": {
            "reference": {
              "kind": "doc",
              "path": "10-design-score/90-troubleshooting"
            }
          }
        },
        {
          "insert": " lists the problems seen so far and their fixes. "
        },
        {
          "insert": "Writing",
          "attributes": {
            "reference": {
              "kind": "doc",
              "path": "10-design-score/80-writing"
            }
          }
        },
        {
          "insert": " and "
        },
        {
          "insert": "Screenshot Judge",
          "attributes": {
            "reference": {
              "kind": "doc",
              "path": "10-design-score/85-screenshot-judge"
            }
          }
        },
        {
          "insert": " cover the rules that no check decides yet."
        }
      ],
      "children": []
    },
    "b2": {
      "id": "b2",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "What It Scores"
        }
      ],
      "children": []
    },
    "b3": {
      "id": "b3",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "A run visits every page in the app config, in each theme and viewport, and records each check as pass, warn, fail or n/a."
        }
      ],
      "children": []
    },
    "b4": {
      "id": "b4",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "Page score",
          "attributes": {
            "bold": true
          }
        }
      ],
      "children": [
        "b5",
        "b6"
      ]
    },
    "b5": {
      "id": "b5",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "Each applicable check counts pass as 1, warn as 0.5 and fail as 0. The page score is the mean times 100."
        }
      ],
      "children": []
    },
    "b6": {
      "id": "b6",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "A check fails on a page when any finding is a fail in any theme or viewport."
        }
      ],
      "children": []
    },
    "b7": {
      "id": "b7",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "App score and area scores",
          "attributes": {
            "bold": true
          }
        }
      ],
      "children": [
        "b8"
      ]
    },
    "b8": {
      "id": "b8",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "The app score is the mean of the page scores. Each area gets a sub-score from the same formula over its own checks."
        }
      ],
      "children": []
    },
