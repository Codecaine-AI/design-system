        {
          "insert": "What It Catches"
        }
      ],
      "children": []
    },
    "catches-lead": {
      "id": "catches-lead",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The check reads the computed padding and gaps of each visible box. A value is on the grid when it is 0, a multiple of 4px, or the 2px or 6px space token."
        }
      ],
      "children": []
    },
    "c1": {
      "id": "c1",
      "type": "list-item",
