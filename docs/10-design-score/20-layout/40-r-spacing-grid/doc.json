    "intro": {
      "id": "intro",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "R-spacing-grid",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " finds padding and gaps that are not on the design system's spacing grid. It is a runtime check in the layout area, so it runs in a browser on every page, theme and viewport. A miss warns and never fails the page."
        }
      ],
      "children": []
    },
    "h-catches": {
      "id": "h-catches",
      "type": "heading",
      "props": {
        "level": 2
      },
