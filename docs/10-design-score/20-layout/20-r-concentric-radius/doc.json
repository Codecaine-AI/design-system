    },
    "fp1a": {
      "id": "fp1a",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "A small badge or chip inset evenly at a card's top left gets compared like a preview pane. It warns even though no one sees the two curves together."
        }
      ],
      "children": []
    },
    "fp2": {
      "id": "fp2",
      "type": "list-item",
      "props": {},
      "text": [
