    "intro": {
      "id": "intro",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "R-concentric-radius",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " finds a rounded child set inside a rounded parent whose corners do not run parallel. It is a runtime check in the layout area, so it runs in a browser on every page, theme and viewport. A miss warns and never fails the page."
        }
      ],
      "children": []
    },
    "h-catches": {
      "id": "h-catches",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "What It Catches"
        }
      ],
      "children": []
    },
    "catches-lead": {
      "id": "catches-lead",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The check reports one finding for each parent and child pair whose corners miss. It skips radii under 4px, because the design system's one radius token is 2px."
        }
      ],
      "children": []
    },
    "c1": {
      "id": "c1",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "Corners that pinch",
          "attributes": {
            "bold": true
          }
        }
      ],
      "children": [
        "c1a",
        "c1b"
      ]
    },
    "c1a": {
      "id": "c1a",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "A child sits the same distance in from its parent's top and left edges. The parent's radius is not the child's radius plus that inset."
        }
      ],
      "children": []
    },
    "c1b": {
      "id": "c1b",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "The common case is a child that copies its parent's radius. The band between the two curves is then thicker at the corner than along the sides."
        }
      ],
      "children": []
    },
    "c2": {
      "id": "c2",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "Only visible surfaces",
          "attributes": {
            "bold": true
          }
        }
      ],
      "children": [
        "c2a"
      ]
    },
    "c2a": {
      "id": "c2a",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "Both the parent and the child need a visible border, shadow or background. A transparent wrapper with a radius is never compared."
        }
      ],
      "children": []
    },
    "h-measures": {
      "id": "h-measures",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "How It Measures"
        }
      ],
      "children": []
    },
    "m-lead": {
      "id": "m-lead",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The probe runs inside the page and reads computed styles and layout boxes. It takes these steps for each visible element."
        }
      ],
      "children": []
    },
    "m1": {
      "id": "m1",
      "type": "list-item",
      "props": {
        "ordered": true
      },
      "text": [
        {
          "insert": "scripts/design-score/run.ts",
          "attributes": {
            "code": true,
            "reference": {
              "kind": "source",
              "path": "scripts/design-score/run.ts",
              "symbol": "runScore"
            }
          }
        },
        {
          "insert": " calls "
        },
        {
          "insert": "probePage",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " once per theme and viewport, after the page's actions and settle time. It also passes "
        },
        {
          "insert": "baseRadii",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", the radius tokens other than none and pill."
        }
      ],
      "children": []
    },
    "m2": {
      "id": "m2",
      "type": "list-item",
      "props": {
        "ordered": true
      },
      "text": [
        {
          "insert": "The radius pass",
          "attributes": {
            "reference": {
              "kind": "source",
              "path": "scripts/design-score/probes.ts",
              "symbol": "R-concentric-radius"
            }
          }
        },
        {
          "insert": " reads the parent's top-left "
        },
        {
          "insert": "border-radius",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". It skips a parent with no radius, a percent radius, a pill shape or no chrome ("
        },
        {
          "insert": "hasChrome",
          "attributes": {
            "code": true,
            "reference": {
              "kind": "source",
              "path": "scripts/design-score/probes.ts",
              "symbol": "hasChrome"
            }
          }
        },
        {
          "insert": ")."
        }
      ],
      "children": []
    },
    "m3": {
      "id": "m3",
      "type": "list-item",
      "props": {
        "ordered": true
      },
      "text": [
        {
          "insert": "It reads up to 30 children and grandchildren and skips each one under the same rules. It also skips a pair where both radii are base radius tokens."
        }
      ],
      "children": []
    },
    "m4": {
      "id": "m4",
      "type": "list-item",
      "props": {
        "ordered": true
      },
      "text": [
        {
          "insert": "It measures the inset as the child's left offset inside the parent's border. The inset must be from 0.5px to 24px, and the top inset must match it within 1px."
        }
      ],
      "children": []
    },
    "m5": {
      "id": "m5",
      "type": "list-item",
      "props": {
        "ordered": true
      },
      "text": [
        {
          "insert": "It compares the parent's radius minus its border with the child's radius plus the inset. A miss over the tolerance makes one warn finding, and the pass moves to the next parent."
        }
      ],
      "children": []
    },
    "m-after": {
      "id": "m-after",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "A shape counts as a pill when its radius is at least half its shorter side, less 1px. Each finding has a key made from the class signatures of the parent and the child, so repeated cards report once."
        }
      ],
      "children": []
    },
    "h-thresholds": {
      "id": "h-thresholds",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "Thresholds"
        }
      ],
      "children": []
    },
    "t-lead": {
      "id": "t-lead",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The check reads the top-left corner only. Every value comes from the computed style in CSS pixels."
        }
      ],
      "children": []
    },
    "t-table": {
      "id": "t-table",
      "type": "structured-table",
      "props": {
        "columns": [
          "Measure",
          "Value"
        ],
        "rows": [
          [
            "Radii checked",
            "The larger of the two is 4px or more"
          ],
          [
            "Inset",
            "0.5px to 24px, top and left within 1px"
          ],
          [
            "Expected parent radius",
            "Child radius + inset + parent border"
          ],
          [
            "Tolerance",
            "2px, or 25% of child radius + inset when that is larger"
          ],
          [
            "Skipped pairs",
            "Both radii on a base radius token, a percent radius, or a pill"
          ],
          [
            "Severity",
            "Warn"
          ]
        ],
        "title": "R-concentric-radius thresholds"
      },
      "children": []
    },
    "t-after": {
      "id": "t-after",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "A 4px child inset 8px expects 12px with a 3px tolerance. Inside a 1px border, a parent radius from 10px to 16px passes."
        }
      ],
      "children": []
    },
    "h-example": {
      "id": "h-example",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "Example"
        }
      ],
      "children": []
    },
    "e-lead": {
      "id": "e-lead",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The fixture pair is "
        },
        {
          "insert": "design-score/fixtures/R-concentric-radius/",
          "attributes": {
            "code": true,
            "reference": {
              "kind": "source",
              "path": "design-score/fixtures/R-concentric-radius"
            }
          }
        },
        {
          "insert": ". Both pages show three file cards with a 12px radius, a 1px border and an 8px inset. The good page gives each preview "
        },
        {
          "insert": "calc(var(--ds-radius-base) * 2)",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", which is 4px. The bad page gives each preview the card's own 12px radius."
        }
      ],
      "children": []
    },
