    },
    "fp2a": {
      "id": "fp2a",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "The check reads only the top-left radius. A tab rounded on top or a child rounded on one side is judged by that one corner."
        }
      ],
      "children": []
    },
