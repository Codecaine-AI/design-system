    "intro": {
      "id": "intro",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "R-control-height",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " finds buttons, inputs and selects that sit side by side in one row but have different heights. It is a runtime check in the layout area, so it runs in a browser on every page, theme and viewport. Any finding fails the page."
        }
      ],
      "children": []
    },
    "h-catches": {
      "id": "h-catches",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "What It Catches"
        }
      ],
      "children": []
    },
    "catches-lead": {
      "id": "catches-lead",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The check compares each pair of controls in one row. A pair fails when the two heights differ by 1px or more."
        }
      ],
      "children": []
    },
    "c1": {
      "id": "c1",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "Which elements count",
          "attributes": {
            "bold": true
          }
        }
      ],
      "children": [
        "c1a",
        "c1b"
      ]
    },
    "c1a": {
      "id": "c1a",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "Buttons, inputs, selects, elements with the "
        },
        {
          "insert": "button",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " or "
        },
        {
          "insert": "combobox",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " role, and links that are not inline. Each one needs a visible border, shadow or fill."
        }
      ],
      "children": []
    },
    "c1b": {
      "id": "c1b",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "Checkboxes, radio buttons, range sliders and hidden inputs do not count."
        }
      ],
      "children": []
    },
    "c2": {
      "id": "c2",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "Which pairs count",
          "attributes": {
            "bold": true
          }
        }
      ],
      "children": [
        "c2a"
      ]
    },
    "c2a": {
      "id": "c2a",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "The second control starts 0 to 16px right of the first and overlaps at least half of the shorter height. The two share an ancestor within 4 levels."
        }
      ],
      "children": []
    },
    "h-measures": {
      "id": "h-measures",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "How It Measures"
        }
      ],
      "children": []
    },
    "m-lead": {
      "id": "m-lead",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The probe runs inside the page and reads layout boxes with "
        },
        {
          "insert": "getBoundingClientRect",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". It takes these steps in order."
        }
      ],
      "children": []
    },
    "m1": {
      "id": "m1",
      "type": "list-item",
      "props": {
        "ordered": true
      },
      "text": [
        {
          "insert": "scripts/design-score/run.ts",
          "attributes": {
            "code": true,
            "reference": {
              "kind": "source",
              "path": "scripts/design-score/run.ts",
              "symbol": "runScore"
            }
          }
        },
        {
          "insert": " calls "
        },
        {
          "insert": "probePage",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " once per theme and viewport, after the page's actions and settle time."
        }
      ],
      "children": []
    },
    "m2": {
      "id": "m2",
      "type": "list-item",
      "props": {
        "ordered": true
      },
      "text": [
        {
          "insert": "The control filter",
          "attributes": {
            "reference": {
              "kind": "source",
              "path": "scripts/design-score/probes.ts",
              "symbol": "controls"
            }
          }
        },
        {
          "insert": " keeps each matching element from 16px to 64px tall. The element needs chrome ("
        },
        {
          "insert": "hasChrome",
          "attributes": {
            "code": true,
            "reference": {
              "kind": "source",
              "path": "scripts/design-score/probes.ts",
              "symbol": "hasChrome"
            }
          }
        },
        {
          "insert": ") and no clipping ancestor ("
        },
        {
          "insert": "unclipped",
          "attributes": {
            "code": true,
            "reference": {
              "kind": "source",
              "path": "scripts/design-score/probes.ts",
              "symbol": "unclipped"
            }
          }
        },
        {
          "insert": ")."
        }
      ],
      "children": []
    },
    "m3": {
      "id": "m3",
      "type": "list-item",
      "props": {
        "ordered": true
      },
      "text": [
        {
          "insert": "The filter drops an inline link, and a link more than 12 times as wide as it is tall. Such a link is a list row, not a control."
        }
      ],
      "children": []
    },
    "m4": {
      "id": "m4",
      "type": "list-item",
      "props": {
        "ordered": true
      },
      "text": [
        {
          "insert": "The pair pass",
          "attributes": {
            "reference": {
              "kind": "source",
              "path": "scripts/design-score/probes.ts",
              "symbol": "R-control-height"
            }
          }
        },
        {
          "insert": " compares every two controls where neither contains the other. It applies the gap, the overlap and the shared-ancestor rule ("
        },
        {
          "insert": "lca",
          "attributes": {
            "code": true,
            "reference": {
              "kind": "source",
              "path": "scripts/design-score/probes.ts",
              "symbol": "lca"
            }
          }
        },
        {
          "insert": ")."
        }
      ],
      "children": []
    },
    "m5": {
      "id": "m5",
      "type": "list-item",
      "props": {
        "ordered": true
      },
      "text": [
        {
          "insert": "A pair whose heights differ by 1px or more makes one fail finding, with a guide line through both bottom edges."
        }
      ],
      "children": []
    },
    "m-after": {
      "id": "m-after",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Chrome is a visible border, a shadow, or a background that differs from the parent's. A borderless icon button or a link with no fill is not compared. Each finding has a key made from both class signatures, so repeated toolbars report once."
        }
      ],
      "children": []
    },
