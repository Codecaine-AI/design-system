        "c4a"
      ]
    },
    "c4a": {
      "id": "c4a",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "The center of a drag handle's mark misses the center of its row's first text line by 1px or more. This fails."
        }
      ],
      "children": []
    },
    "h-measures": {
      "id": "h-measures",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "How It Measures"
        }
      ],
      "children": []
    },
    "m-lead": {
      "id": "m-lead",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The probe runs inside the page and reads layout boxes with "
        },
        {
          "insert": "getBoundingClientRect",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " and text ranges. It takes these steps in order."
        }
      ],
      "children": []
    },
    "m1": {
      "id": "m1",
      "type": "list-item",
      "props": {
        "ordered": true
      },
      "text": [
        {
          "insert": "scripts/design-score/run.ts",
          "attributes": {
            "code": true,
            "reference": {
              "kind": "source",
              "path": "scripts/design-score/run.ts",
              "symbol": "runScore"
            }
          }
        },
        {
          "insert": " calls "
        },
        {
          "insert": "probePage",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " once per theme and viewport, after the page's actions and settle time."
        }
      ],
      "children": []
    },
    "m2": {
      "id": "m2",
      "type": "list-item",
      "props": {
        "ordered": true
      },
      "text": [
        {
          "insert": "probePage",
          "attributes": {
            "code": true,
            "reference": {
              "kind": "source",
              "path": "scripts/design-score/probes.ts",
              "symbol": "R-align-near-miss"
            }
          }
        },
        {
          "insert": " collects each visible text element by its first line, and each box from 6px up to 60% of the viewport. A box is an svg, img or form control, or an element with a border, shadow or background."
        }
      ],
      "children": []
    },
    "m3": {
      "id": "m3",
      "type": "list-item",
      "props": {
        "ordered": true
      },
      "text": [
        {
          "insert": "The column pass",
          "attributes": {
            "reference": {
              "kind": "source",
              "path": "scripts/design-score/probes.ts",
              "symbol": "Column"
            }
          }
        },
        {
          "insert": " takes the nearest atom of the same kind below each atom, up to 40px down and within 3px of its left edge, and compares the two left edges."
        }
      ],
      "children": []
    },
    "m4": {
      "id": "m4",
      "type": "list-item",
      "props": {
        "ordered": true
      },
      "text": [
        {
          "insert": "The row pass",
          "attributes": {
            "reference": {
              "kind": "source",
              "path": "scripts/design-score/probes.ts",
              "symbol": "Row"
            }
          }
        },
        {
          "insert": " takes the nearest atom to the right, up to 24px away and overlapping by 60% of the shorter height, and compares the two vertical centers."
        }
      ],
      "children": []
    },
    "m5": {
      "id": "m5",
      "type": "list-item",
      "props": {
        "ordered": true
      },
      "text": [
        {
          "insert": "The handle pass",
          "attributes": {
            "reference": {
              "kind": "source",
              "path": "scripts/design-score/probes.ts",
              "symbol": "Handles"
            }
          }
        },
        {
          "insert": " finds the text at the handle's center height with "
        },
        {
          "insert": "caretPositionFromPoint",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", takes the first glyph of that block, and compares the two centers."
        }
      ],
      "children": []
    },
    "m-pairs": {
      "id": "m-pairs",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Two atoms count as neighbors only when they share an ancestor within 6 levels that is not "
        },
        {
          "insert": "body",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", "
        },
        {
          "insert": "#root",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " or "
        },
        {
          "insert": ".ds-shell",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " ("
        },
        {
          "insert": "related",
          "attributes": {
            "code": true,
            "reference": {
              "kind": "source",
              "path": "scripts/design-score/probes.ts",
              "symbol": "related"
            }
          }
        },
        {
          "insert": "). A column pair that lines up another way is skipped: the same right edge, the same center, or texts in two different chips ("
        },
        {
          "insert": "alignedOtherwise",
          "attributes": {
            "code": true,
            "reference": {
              "kind": "source",
              "path": "scripts/design-score/probes.ts",
              "symbol": "alignedOtherwise"
            }
          }
        },
        {
          "insert": ")."
        }
      ],
      "children": []
    },
    "m-handles": {
      "id": "m-handles",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "A handle is an element that matches the app config's "
        },
        {
          "insert": "handles",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " selectors, "
