    "intro": {
      "id": "intro",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "R-align-near-miss",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " finds elements that almost line up but miss by 1 to 3px, and drag handles that sit off their row's first text line. It is a runtime check in the layout area, so it runs in a browser on every page, theme and viewport. A text-column miss or a handle miss fails the page, and the other near misses warn."
        }
      ],
      "children": []
    },
    "h-catches": {
      "id": "h-catches",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "What It Catches"
        }
      ],
      "children": []
    },
    "catches-lead": {
      "id": "catches-lead",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The check reports four kinds of near miss. An offset of 4px or more counts as deliberate and is never reported."
        }
      ],
      "children": []
    },
    "c1": {
      "id": "c1",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "Left edges in a column",
          "attributes": {
            "bold": true
          }
        }
      ],
      "children": [
        "c1a"
      ]
    },
    "c1a": {
      "id": "c1a",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "Two neighbors, one under the other, have left edges 1 to 3px apart. Two text lines fail, and two boxes warn."
        }
      ],
      "children": []
    },
    "c2": {
      "id": "c2",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "Right edges in a column",
          "attributes": {
            "bold": true
          }
        }
      ],
      "children": [
        "c2a"
      ]
    },
    "c2a": {
      "id": "c2a",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "Two right-aligned texts, one under the other, have right edges 1 to 3px apart. This warns."
        }
      ],
      "children": []
    },
    "c3": {
      "id": "c3",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "Centers in a row",
          "attributes": {
            "bold": true
          }
        }
      ],
      "children": [
        "c3a",
        "c3b"
      ]
    },
    "c3a": {
      "id": "c3a",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "A box beside text, or two boxes side by side, have vertical centers 1 to 3px apart. This warns."
        }
      ],
      "children": []
    },
    "c3b": {
      "id": "c3b",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "Two texts side by side are not compared, because text lines up by its baseline."
        }
      ],
      "children": []
    },
    "c4": {
      "id": "c4",
      "type": "list-item",
      "props": {},
      "text": [
        {
