        {
          "insert": ", "
        },
        {
          "insert": "[data-drag-handle]",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", a button whose "
        },
        {
          "insert": "aria-label",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " contains drag or reorder, or a class that contains "
        },
        {
          "insert": "drag-handle",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " or "
        },
        {
          "insert": "grip",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " ("
        },
        {
          "insert": "handleSel",
          "attributes": {
            "code": true,
            "reference": {
              "kind": "source",
              "path": "scripts/design-score/probes.ts",
              "symbol": "handleSel"
            }
          }
        },
        {
          "insert": "). The label counts only on a "
        },
        {
          "insert": "button",
          "attributes": {
            "code": true
