    "intro": {
      "id": "intro",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "R-h-scroll",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " finds a page, or a main content area, that scrolls sideways. It is a runtime check in the layout area, so it runs in a browser on every page, theme and viewport. Any finding fails the page."
        }
      ],
      "children": []
    },
