    "intro": {
      "id": "intro",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The layout checks measure where boxes sit on the rendered page: edges, centers, radii, spacing and row heights. They run in a browser on every page, theme and viewport. The area has 5 runtime checks and 43 rules in "
        },
        {
          "insert": "design-score/rules/layout.json",
          "attributes": {
            "code": true,
            "reference": {
              "kind": "source",
              "path": "design-score/rules/layout.json"
            }
          }
        },
        {
          "insert": "."
        }
      ],
      "children": []
    },
