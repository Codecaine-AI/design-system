    "intro": {
      "id": "intro",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The screenshot judge is "
        },
        {
          "insert": "V-judge",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", a vision model that rates each page's state screenshots against taste rules such as hierarchy, grouping and polish. Its area holds 32 rules: the 26 rules mapped to "
        },
        {
          "insert": "V-judge",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " and 6 process rules that need a person or a model. The rules are in "
        },
        {
          "insert": "design-score/rules/judge.json",
          "attributes": {
            "code": true,
            "reference": {
              "kind": "source",
              "path": "design-score/rules/judge.json"
            }
          }
        },
        {
          "insert": "."
        }
      ],
      "children": []
    },
    "planned": {
      "id": "planned",
      "type": "callout",
      "props": {
        "title": "Planned, not built",
        "tone": "warning"
      },
      "text": [
        {
          "insert": "V-judge does not run in this version, so every page marks it n/a. Each run already saves the state screenshots it will read ("
        },
        {
          "insert": "scripts/design-score/judge.ts",
          "attributes": {
            "code": true,
            "reference": {
              "kind": "source",
              "path": "scripts/design-score/judge.ts"
            }
          }
        },
        {
          "insert": ")."
        }
      ],
      "children": []
    },
    "h-how": {
      "id": "h-how",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "How It Will Work"
        }
      ],
      "children": []
    },
    "how-lead": {
      "id": "how-lead",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The judge compares fixed screenshots, and code picks them. The app config lists the pages, so the judge never chooses an easy screenshot. Each judged pair goes through these steps."
        }
      ],
      "children": []
    },
    "how1": {
      "id": "how1",
      "type": "list-item",
      "props": {
        "ordered": true
      },
      "text": [
        {
          "insert": "A run saves the state screenshot of each page, theme and viewport, as every run does today."
        }
      ],
      "children": []
    },
    "how2": {
      "id": "how2",
      "type": "list-item",
      "props": {
        "ordered": true
      },
      "text": [
        {
          "insert": "The judge takes the before and after screenshots of one page state from two runs. Only pairs whose pixels changed go in."
        }
      ],
      "children": []
    },
    "how3": {
      "id": "how3",
      "type": "list-item",
      "props": {
        "ordered": true
      },
      "text": [
        {
          "insert": "For each rule, the judge asks one yes or no question and boxes the region its answer is about."
        }
      ],
      "children": []
    },
    "how4": {
      "id": "how4",
      "type": "list-item",
      "props": {
        "ordered": true
      },
      "text": [
        {
          "insert": "A cheap model answers first. A strong model answers again for each no and each unsure answer."
        }
      ],
      "children": []
    },
    "how5": {
      "id": "how5",
      "type": "list-item",
      "props": {
        "ordered": true
      },
      "text": [
        {
          "insert": "When the two models disagree, or the strong model is unsure, the pair and its boxes go to Ford."
        }
      ],
      "children": []
    },
    "how-after": {
      "id": "how-after",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "A judge finding has the same shape as every other finding, with "
        },
        {
          "insert": "check: \"V-judge\"",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", a severity, the page, theme, viewport and box. Motion rules get a strip of frames instead of one still, because a still cannot show motion."
        }
      ],
      "children": []
    },
    "h-cal": {
      "id": "h-cal",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "Calibration"
        }
      ],
      "children": []
    },
    "cal-lead": {
      "id": "cal-lead",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The judge must agree with known answers before its findings count. Three label sets give those answers, and agreement is reported per rule group, not as one number."
        }
      ],
      "children": []
    },
