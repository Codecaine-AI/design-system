          "attributes": {
            "bold": true
          }
        }
      ],
      "children": [
        "built3a"
      ]
    },
    "built3a": {
      "id": "built3a",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "bun run design:judge-calibrate",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " scores the judge on issue 20 and writes the per-item verdicts to "
        },
        {
          "insert": ".design-score/judge-calibration/",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "."
