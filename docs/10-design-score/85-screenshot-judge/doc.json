      ],
      "children": []
    },
    "rules-lead": {
      "id": "rules-lead",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "26 rules map to "
        },
        {
          "insert": "V-judge",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " in five groups, and each row gives the yes or no question the judge will ask. A yes passes. Five rules are marked text-only, so the judge reads extracted strings instead of pixels."
        }
      ],
      "children": []
    },
