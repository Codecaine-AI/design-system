    "bar1a": {
      "id": "bar1a",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "The judge counts in a score only while it agrees with Ford on 80% or more of the labelled pairs."
        }
      ],
      "children": []
    },
    "bar1b": {
      "id": "bar1b",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "Below that bar, its findings are advisory and "
        },
        {
          "insert": "V-judge",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " stays n/a. A finding fails a page only on a confident no from the strong model."
        }
      ],
      "children": []
    },
    "bar2": {
      "id": "bar2",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "Cost cap",
          "attributes": {
            "bold": true
          }
        }
      ],
      "children": [
        "bar2a",
        "bar2b"
      ]
    },
    "bar2a": {
      "id": "bar2a",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "Only changed pairs go to a model, and only no or unsure answers go to the strong model. The research estimate is a few dozen calls per pull request."
        }
      ],
      "children": []
    },
    "bar2b": {
      "id": "bar2b",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "Each run gets a hard limit on model calls. At the limit the judge stops and reports the pairs it did not judge."
        }
      ],
      "children": []
    },
