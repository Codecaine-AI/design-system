    "ss14": {
      "id": "ss14",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "How It Measures"
        }
      ],
      "children": []
    },
    "ss15": {
      "id": "ss15",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The pass drives the page with Playwright and reads boxes inside it. It takes these steps in order."
        }
      ],
      "children": []
    },
    "ss16": {
      "id": "ss16",
      "type": "list-item",
      "props": {
        "ordered": true
      },
      "text": [
        {
          "insert": "stateShiftPass",
          "attributes": {
            "code": true,
            "reference": {
              "kind": "source",
              "path": "scripts/design-score/state-shift.ts",
              "symbol": "stateShiftPass"
            }
          }
        },
        {
          "insert": " adds "
        },
        {
          "insert": "NO_MOTION",
          "attributes": {
            "code": true,
            "reference": {
              "kind": "source",
              "path": "scripts/design-score/state-shift.ts",
              "symbol": "NO_MOTION"
            }
          }
        },
        {
          "insert": ", a style that turns off every transition and animation, so each box is read at its end state."
        }
      ],
      "children": []
    },
    "ss17": {
      "id": "ss17",
      "type": "list-item",
      "props": {
        "ordered": true
      },
      "text": [
        {
          "insert": "shiftCandidates",
          "attributes": {
            "code": true,
            "reference": {
              "kind": "source",
              "path": "scripts/design-score/state-shift.ts",
              "symbol": "shiftCandidates"
            }
          }
        },
        {
          "insert": " picks up to 16 controls, one per class signature, that sit fully in the viewport. It also picks popup controls and up to 3 tab lists."
        }
      ],
      "children": []
    },
    "ss18": {
      "id": "ss18",
      "type": "list-item",
      "props": {
        "ordered": true
      },
      "text": [
        {
          "insert": "shiftStability",
          "attributes": {
            "code": true,
            "reference": {
              "kind": "source",
              "path": "scripts/design-score/state-shift.ts",
              "symbol": "shiftStability"
            }
          }
        },
        {
          "insert": " reads every box twice, 300ms apart, and leaves out the elements that move on their own."
        }
      ],
      "children": []
    },
    "ss19": {
      "id": "ss19",
      "type": "list-item",
      "props": {
        "ordered": true
      },
      "text": [
        {
          "insert": "measure",
          "attributes": {
            "code": true,
            "reference": {
              "kind": "source",
              "path": "scripts/design-score/state-shift.ts",
              "symbol": "measure"
            }
          }
        },
        {
          "insert": " reads up to 300 elements around the control, makes the change, waits 90ms and reads them again. The area is the control's ancestor up to 3 levels up."
        }
      ],
      "children": []
    },
    "ss20": {
      "id": "ss20",
      "type": "list-item",
      "props": {
        "ordered": true
      },
      "text": [
        {
          "insert": "diffShift",
          "attributes": {
            "code": true,
            "reference": {
              "kind": "source",
              "path": "scripts/design-score/state-shift.ts",
              "symbol": "diffShift"
            }
          }
        },
        {
          "insert": " counts a move only when the client rect and the layout box both change by 1px or more."
        }
      ],
      "children": []
    },
    "ss20b": {
      "id": "ss20b",
      "type": "list-item",
      "props": {
        "ordered": true
      },
      "text": [
        {
          "insert": "dropScrollbarMoves",
          "attributes": {
            "code": true,
            "reference": {
              "kind": "source",
              "path": "scripts/design-score/state-shift.ts",
              "symbol": "dropScrollbarMoves"
            }
          }
        },
        {
          "insert": " drops a move that a classic scrollbar explains."
        }
      ],
      "children": []
    },
    "ss21": {
      "id": "ss21",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "An element that is hidden before or after the change, such as the menu that opens, is left out. Each finding stands for one verb and one component, so 12 rows of the same button report once."
        }
      ],
      "children": []
    },
    "ss22": {
