    "ss1": {
      "id": "ss1",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "R-state-shift",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " hovers, focuses, opens and selects controls, and fails when that moves or resizes the layout. It is a runtime check in the interaction area. It runs once per page, in the first theme and viewport, after the other runtime checks. The run first restores the scroll positions that the page state left, because the focus pass scrolls the page."
        }
      ],
      "children": []
    },
    "ss2": {
      "id": "ss2",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "What It Catches"
        }
      ],
      "children": []
    },
    "ss3": {
      "id": "ss3",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The check makes four kinds of state change on each control. A change fails when a visible neighbor, or the control itself, changes its layout box by 1px or more."
        }
      ],
      "children": []
    },
    "ss4": {
      "id": "ss4",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "Hover",
          "attributes": {
            "bold": true
          }
        }
      ],
      "children": [
        "ss5"
      ]
    },
    "ss5": {
      "id": "ss5",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "The real mouse moves to the control's center, so JS hover handlers run too."
        }
      ],
      "children": []
    },
    "ss6": {
      "id": "ss6",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "Focus",
          "attributes": {
            "bold": true
          }
        }
      ],
      "children": [
        "ss7"
      ]
    },
    "ss7": {
      "id": "ss7",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "The check calls "
        },
        {
          "insert": "element.focus({ preventScroll: true })",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " and then blurs the control."
        }
      ],
      "children": []
    },
    "ss8": {
      "id": "ss8",
      "type": "list-item",
      "props": {},
      "text": [
        {
