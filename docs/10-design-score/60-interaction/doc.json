    "intro": {
      "id": "intro",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The interaction checks cover hover, focus, press and hit targets. They test that a control reacts without moving the layout, and that it is large enough to hit. The area has 2 static checks, 2 runtime checks, 1 motion check and 28 rules in "
        },
        {
          "insert": "design-score/rules/interaction.json",
          "attributes": {
            "code": true,
            "reference": {
              "kind": "source",
              "path": "design-score/rules/interaction.json"
            }
          }
        },
        {
          "insert": "."
        }
      ],
      "children": []
    },
