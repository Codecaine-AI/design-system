      "id": "h-checks",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "Checks"
        }
      ],
      "children": []
    },
    "ia1": {
      "id": "ia1",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Each check has its own page with its thresholds, a good and bad fixture pair, and its known false positives. The static checks read source files, and the others run in a browser."
        }
      ],
      "children": []
    },
