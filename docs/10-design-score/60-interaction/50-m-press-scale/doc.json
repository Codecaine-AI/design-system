    "ps1": {
      "id": "ps1",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "M-press-scale",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " presses each kind of control and reads how far it scales on "
        },
        {
          "insert": ":active",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". It is a motion check in the interaction area, so it runs in the motion pass, in the first theme and viewport. A scale below 0.95 fails, a scale from 0.98 to 1 warns, and a control that does not scale is not judged."
        }
      ],
      "children": []
    },
    "ps2": {
      "id": "ps2",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "What It Catches"
        }
      ],
      "children": []
    },
    "ps3": {
      "id": "ps3",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "A press scale tells the user that the click landed. The check reports two kinds of press scale outside the 0.95 to 0.98 band."
        }
      ],
      "children": []
    },
    "ps4": {
      "id": "ps4",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "A press that is too deep",
          "attributes": {
            "bold": true
          }
        }
      ],
      "children": [
        "ps5"
      ]
    },
    "ps5": {
      "id": "ps5",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "The control scales below 0.95 on "
        },
        {
          "insert": ":active",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", so it looks like it drops away. This fails."
        }
      ],
      "children": []
    },
    "ps6": {
      "id": "ps6",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "A press that is too small",
          "attributes": {
            "bold": true
          }
        }
      ],
      "children": [
        "ps7"
      ]
    },
    "ps7": {
      "id": "ps7",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "The control scales above 0.98 but stays under 0.999, so the press is too small to see. This warns."
        }
      ],
      "children": []
    },
    "ps8": {
      "id": "ps8",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "Controls it does not judge",
          "attributes": {
            "bold": true
          }
        }
      ],
      "children": [
        "ps9"
      ]
    },
    "ps9": {
      "id": "ps9",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "A control that keeps its scale on "
        },
        {
          "insert": ":active",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " has no press scale and gets no finding."
        }
      ],
      "children": []
    },
    "ps10": {
      "id": "ps10",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "How It Measures"
        }
      ],
      "children": []
    },
    "ps11": {
      "id": "ps11",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The motion pass presses controls through the Chrome DevTools Protocol, so no click reaches the app. It takes these steps in order."
        }
      ],
      "children": []
    },
    "ps12": {
      "id": "ps12",
      "type": "list-item",
      "props": {
        "ordered": true
      },
      "text": [
        {
          "insert": "markMotionCandidates",
          "attributes": {
            "code": true,
            "reference": {
              "kind": "source",
              "path": "scripts/design-score/probes.ts",
              "symbol": "markMotionCandidates"
            }
          }
        },
        {
          "insert": " picks up to 24 visible controls, one per tag and first 3 classes."
        }
      ],
      "children": []
    },
    "ps13": {
      "id": "ps13",
      "type": "list-item",
      "props": {
        "ordered": true
      },
      "text": [
        {
          "insert": "readScale",
          "attributes": {
            "code": true,
            "reference": {
              "kind": "source",
              "path": "scripts/design-score/motion.ts",
              "symbol": "readScale"
            }
          }
        },
        {
          "insert": " reads each control's scale at rest."
        }
      ],
      "children": []
    },
    "ps14": {
      "id": "ps14",
      "type": "list-item",
      "props": {
        "ordered": true
      },
      "text": [
        {
          "insert": "The press loop",
          "attributes": {
            "reference": {
              "kind": "source",
              "path": "scripts/design-score/run.ts",
              "symbol": "Motion"
            }
          }
        },
        {
          "insert": " forces "
        },
        {
          "insert": ":hover",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", then "
        },
        {
          "insert": ":hover:active",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", with "
        },
        {
          "insert": "CSS.forcePseudoState",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". It waits 110ms after each one."
        }
      ],
      "children": []
    },
    "ps15": {
      "id": "ps15",
      "type": "list-item",
      "props": {
        "ordered": true
      },
      "text": [
        {
          "insert": "readScale finishes the control's animations and reads the scale again. It multiplies the "
        },
        {
          "insert": "scale",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " property by the scale in the "
        },
        {
          "insert": "transform",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " matrix."
        }
      ],
      "children": []
    },
    "ps16": {
      "id": "ps16",
      "type": "list-item",
      "props": {
        "ordered": true
      },
      "text": [
        {
          "insert": "The scale pass",
          "attributes": {
            "reference": {
              "kind": "source",
              "path": "scripts/design-score/motion.ts",
              "symbol": "analyzeMotion"
            }
          }
        },
        {
          "insert": " in "
        },
        {
          "insert": "analyzeMotion",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " divides the pressed scale by the rest scale and puts the result in a band."
        }
      ],
      "children": []
    },
    "ps17": {
      "id": "ps17",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "readScale finishes the transition before it reads, so the press duration does not change the result. "
        },
        {
          "insert": "M-duration",
          "attributes": {
            "code": true,
            "link": "10-design-score/50-motion/30-m-duration"
          }
        },
        {
          "insert": " judges how long the press takes."
        }
      ],
      "children": []
    },
    "ps18": {
      "id": "ps18",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "Thresholds"
        }
      ],
      "children": []
    },
    "ps19": {
      "id": "ps19",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The band comes from the rule "
        },
        {
          "insert": "ui-press-scale",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". The token "
        },
        {
          "insert": "--ds-motion-scale-press",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " is 0.96, inside the band."
        }
      ],
      "children": []
    },
