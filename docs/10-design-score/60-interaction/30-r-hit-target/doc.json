    "ht1": {
      "id": "ht1",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "R-hit-target",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " finds buttons, links and other controls that are too small to hit. It is a runtime check in the interaction area, so it runs in a browser on every page, theme and viewport. A target under 24px fails, and a target under 32px warns."
        }
      ],
      "children": []
    },
    "ht2": {
      "id": "ht2",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "What It Catches"
        }
      ],
      "children": []
    },
    "ht3": {
      "id": "ht3",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The check sorts each small target into one of three bands by its smaller side. Inline links in running text are exempt."
        }
      ],
      "children": []
    },
    "ht4": {
      "id": "ht4",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "Crowded targets under 24px",
          "attributes": {
            "bold": true
          }
        }
      ],
      "children": [
        "ht5"
      ]
    },
    "ht5": {
      "id": "ht5",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "The target fails when another target sits inside the 24px circle on its center. It also fails when another small target's circle overlaps its circle."
        }
      ],
      "children": []
    },
    "ht6": {
      "id": "ht6",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "Spaced targets under 24px",
          "attributes": {
            "bold": true
          }
        }
      ],
      "children": [
        "ht7"
      ]
    },
    "ht7": {
      "id": "ht7",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "The target only warns when its 24px circle touches no other target and no other small target's circle. This is the spacing exception of WCAG 2.5.8."
        }
      ],
      "children": []
    },
    "ht8": {
      "id": "ht8",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "Targets from 24 to 32px",
          "attributes": {
            "bold": true
          }
        }
      ],
      "children": [
        "ht9"
      ]
    },
    "ht9": {
      "id": "ht9",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "The target warns. Ford's floor is 32px, above the 24px that WCAG asks for."
        }
      ],
      "children": []
    },
    "ht10": {
      "id": "ht10",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "Exempt links",
          "attributes": {
            "bold": true
          }
        }
      ],
      "children": [
        "ht11",
        "ht12"
      ]
    },
    "ht11": {
      "id": "ht11",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "A link with "
        },
        {
          "insert": "display: inline",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " inside a block of other text is exempt."
        }
      ],
      "children": []
    },
    "ht12": {
      "id": "ht12",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "An "
        },
        {
          "insert": "inline-flex",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " or "
        },
        {
          "insert": "inline-block",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " link in a line of words, and no taller than that line, is exempt too."
        }
      ],
      "children": []
    },
    "ht13": {
      "id": "ht13",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "How It Measures"
        }
      ],
      "children": []
    },
    "ht14": {
      "id": "ht14",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The probe runs inside the page and reads each target's box with "
        },
        {
          "insert": "getBoundingClientRect",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". It takes these steps in order."
        }
      ],
      "children": []
    },
    "ht15": {
      "id": "ht15",
      "type": "list-item",
      "props": {
        "ordered": true
      },
      "text": [
        {
          "insert": "scripts/design-score/run.ts",
          "attributes": {
            "code": true,
            "reference": {
              "kind": "source",
              "path": "scripts/design-score/run.ts",
              "symbol": "runScore"
            }
          }
        },
        {
          "insert": " calls "
        },
        {
          "insert": "probePage",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " once per theme and viewport, after the page's actions and settle time."
        }
      ],
      "children": []
    },
    "ht16": {
      "id": "ht16",
      "type": "list-item",
      "props": {
        "ordered": true
      },
      "text": [
        {
          "insert": "interactiveSel",
          "attributes": {
            "code": true,
            "reference": {
              "kind": "source",
              "path": "scripts/design-score/probes.ts",
              "symbol": "interactiveSel"
            }
          }
        },
        {
          "insert": " picks links, buttons, form controls, "
        },
        {
          "insert": "summary",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", the ARIA widget roles and "
        },
        {
          "insert": "[tabindex]",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " elements. Disabled, hidden, clipped and "
        },
        {
          "insert": "pointer-events: none",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " elements are dropped, and so is a control inside a button or link."
        }
      ],
      "children": []
    },
    "ht17": {
      "id": "ht17",
      "type": "list-item",
      "props": {
        "ordered": true
      },
      "text": [
        {
          "insert": "The label pass",
          "attributes": {
            "reference": {
              "kind": "source",
              "path": "scripts/design-score/probes.ts",
              "symbol": "targetRects"
            }
          }
        },
        {
          "insert": " gives an input the box of its label when the label is larger."
        }
      ],
      "children": []
    },
    "ht18": {
      "id": "ht18",
      "type": "list-item",
      "props": {
        "ordered": true
      },
      "text": [
        {
          "insert": "The size pass",
          "attributes": {
            "reference": {
              "kind": "source",
              "path": "scripts/design-score/probes.ts",
              "symbol": "band"
            }
          }
        },
        {
          "insert": " takes the smaller side of each box and puts the target in a band. A target under 24px gets "
        },
        {
          "insert": "the circle test",
          "attributes": {
            "reference": {
              "kind": "source",
              "path": "scripts/design-score/probes.ts",
              "symbol": "crowded"
            }
          }
        },
        {
          "insert": "."
        }
      ],
      "children": []
    },
    "ht19": {
      "id": "ht19",
      "type": "list-item",
      "props": {
        "ordered": true
      },
      "text": [
        {
          "insert": "The group pass",
          "attributes": {
            "reference": {
              "kind": "source",
              "path": "scripts/design-score/probes.ts",
              "symbol": "hitGroups"
            }
          }
        },
        {
          "insert": " makes one finding per band and component, keyed by tag, classes and role. The finding gives the count and the size range."
        }
      ],
      "children": []
    },
    "ht20": {
      "id": "ht20",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The circle test measures from the target's center. A target is crowded when the nearest point of another target is under 12px away. It is also crowded when another target under 24px has its center under 24px away."
        }
      ],
      "children": []
    },
    "ht21": {
      "id": "ht21",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "Thresholds"
        }
      ],
      "children": []
    },
    "ht22": {
      "id": "ht22",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The bands come from the rule "
        },
        {
          "insert": "a11y-hit-target",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". axe-core's own "
        },
        {
          "insert": "target-size",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " rule is off, so R-axe never reports the same targets."
        }
      ],
      "children": []
    },
