    "hu1": {
      "id": "hu1",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "S-hover-unguarded",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " finds CSS "
        },
        {
          "insert": ":hover",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " rules that sit outside "
        },
        {
          "insert": "@media (hover: hover)",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". It is a static check in the interaction area, so it reads source files and never opens a browser. Each rule it finds warns, and the check never fails a page."
        }
      ],
      "children": []
    },
