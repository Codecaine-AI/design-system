    "b1": {
      "id": "b1",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "S-transition-all",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " finds transitions that animate every property instead of the properties that change. It is a static check in the motion area, so it reads the app's source files with no browser. Every finding fails the check, and the result counts once on every page."
        }
      ],
      "children": []
    },
    "b2": {
      "id": "b2",
      "type": "heading",
      "props": {
        "level": 2
