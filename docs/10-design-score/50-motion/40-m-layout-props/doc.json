    "b1": {
      "id": "b1",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "M-layout-props",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " finds transitions and animations on layout properties, such as width, height, top, margin and padding. The browser lays out the page again on every frame of such an animation, and the text inside reflows. It is a motion check: an animation seen running fails, and a transition that is only declared warns."
        }
      ],
      "children": []
    },
    "b2": {
      "id": "b2",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "What It Catches"
        }
      ],
      "children": []
    },
    "b3": {
      "id": "b3",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The check reports layout motion from two kinds of evidence, and the app config can allow some of it."
        }
      ],
      "children": []
    },
    "b4": {
      "id": "b4",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "Seen running",
          "attributes": {
            "bold": true
          }
        }
      ],
      "children": [
        "b5"
      ]
    },
    "b5": {
      "id": "b5",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "An animation on a layout property fails when the recorder sees it run longer than 0ms. The page's actions or a forced hover or press must start it."
        }
      ],
      "children": []
    },
    "b6": {
      "id": "b6",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "Declared only",
          "attributes": {
            "bold": true
          }
        }
      ],
      "children": [
        "b7",
        "b8"
      ]
    },
    "b7": {
      "id": "b7",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "A visible element whose computed "
        },
        {
          "insert": "transition-property",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " lists a layout property with a duration over 0 warns, though nothing ran."
        }
      ],
      "children": []
    },
    "b8": {
      "id": "b8",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "transition-property: all",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " is not read here. "
        },
        {
          "insert": "S-transition-all",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " reports it."
        }
      ],
      "children": []
    },
    "b9": {
      "id": "b9",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "Allowed by the app config",
          "attributes": {
            "bold": true
          }
        }
      ],
      "children": [
        "b10"
      ]
    },
    "b10": {
      "id": "b10",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "A "
        },
        {
          "insert": "motionAllow",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " entry names a selector, the layout properties allowed on it and a reason. A finding it covers shows in the report but does not count."
        }
      ],
      "children": []
    },
    "b11": {
      "id": "b11",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "How It Measures"
        }
      ],
      "children": []
    },
    "b12": {
      "id": "b12",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The check uses the same recorder and hover pass as "
        },
        {
          "insert": "M-duration",
          "attributes": {
            "code": true,
            "link": "10-design-score/50-motion/30-m-duration"
          }
        },
        {
          "insert": ". It takes these steps in order."
        }
      ],
      "children": []
    },
    "b13": {
      "id": "b13",
      "type": "list-item",
      "props": {
        "ordered": true
      },
      "text": [
        {
          "insert": "scripts/design-score/run.ts",
          "attributes": {
            "code": true,
            "reference": {
              "kind": "source",
              "path": "scripts/design-score/run.ts",
              "symbol": "Motion"
            }
          }
        },
        {
          "insert": " records every animation during the page's actions, then hovers and presses up to 24 controls."
        }
      ],
      "children": []
    },
    "b14": {
      "id": "b14",
      "type": "list-item",
      "props": {
        "ordered": true
      },
      "text": [
        {
          "insert": "analyzeMotion",
          "attributes": {
            "code": true,
            "reference": {
              "kind": "source",
              "path": "scripts/design-score/motion.ts",
              "symbol": "analyzeMotion"
            }
          }
        },
        {
          "insert": " keeps each record's properties that match "
        },
        {
          "insert": "LAYOUT_PROP",
          "attributes": {
            "code": true,
            "reference": {
              "kind": "source",
              "path": "scripts/design-score/motion.ts",
              "symbol": "LAYOUT_PROP"
            }
          }
        },
        {
          "insert": ", and moves the ones "
        },
        {
          "insert": "motionAllow",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " allows to the allowed list."
        }
      ],
      "children": []
    },
    "b15": {
      "id": "b15",
      "type": "list-item",
      "props": {
        "ordered": true
      },
      "text": [
        {
          "insert": "After the hover pass, "
        },
        {
          "insert": "declaredLayoutTransitions",
          "attributes": {
            "code": true,
            "reference": {
              "kind": "source",
              "path": "scripts/design-score/motion.ts",
              "symbol": "declaredLayoutTransitions"
            }
          }
        },
        {
          "insert": " walks every element in the body and reads its computed "
        },
        {
          "insert": "transitionProperty",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " and "
        },
        {
          "insert": "transitionDuration",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "."
        }
      ],
      "children": []
    },
    "b16": {
      "id": "b16",
      "type": "list-item",
      "props": {
        "ordered": true
      },
      "text": [
        {
          "insert": "The declared pass",
          "attributes": {
            "reference": {
              "kind": "source",
              "path": "scripts/design-score/motion.ts",
              "symbol": "analyzeMotion"
            }
          }
        },
        {
          "insert": " drops a declared finding when the same selector already has a running finding."
        }
      ],
      "children": []
    },
    "b17": {
      "id": "b17",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Each selector and property list reports once, so repeated rows report once per component."
