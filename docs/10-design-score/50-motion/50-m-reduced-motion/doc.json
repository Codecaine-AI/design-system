    "b1": {
      "id": "b1",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "M-reduced-motion",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " finds movement that still runs when the user asks the system for less motion. The run repeats the motion pass with "
        },
        {
          "insert": "prefers-reduced-motion: reduce",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " and reports each moving animation it sees. Every finding is a warning, because Ford decided that reduced-motion rules only warn."
        }
      ],
      "children": []
    },
    "b2": {
      "id": "b2",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "What It Catches"
        }
      ],
      "children": []
    },
    "b3": {
      "id": "b3",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The check reports movement under reduce from three sources. A fade is the expected replacement, so it never reports one."
        }
      ],
      "children": []
    },
    "b4": {
      "id": "b4",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "Movement on a page state",
          "attributes": {
            "bold": true
          }
        }
      ],
      "children": [
        "b5"
      ]
    },
    "b5": {
      "id": "b5",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "A moving animation that runs while the page's actions run warns, such as a toast that slides in."
        }
      ],
      "children": []
    },
    "b6": {
      "id": "b6",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "Movement on hover or press",
          "attributes": {
            "bold": true
          }
        }
      ],
      "children": [
        "b7"
      ]
    },
    "b7": {
      "id": "b7",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "A moving transition warns when the run hovers or presses a control, such as a button that lifts."
        }
      ],
      "children": []
    },
    "b8": {
      "id": "b8",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "Loops",
