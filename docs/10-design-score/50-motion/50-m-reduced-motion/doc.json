    "b14": {
      "id": "b14",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The check reuses the recorder from "
        },
        {
          "insert": "M-duration",
          "attributes": {
            "code": true,
            "link": "10-design-score/50-motion/30-m-duration"
          }
        },
        {
          "insert": " in a second context. It takes these steps in order."
        }
      ],
      "children": []
    },
    "b15": {
      "id": "b15",
      "type": "list-item",
      "props": {
        "ordered": true
      },
      "text": [
        {
          "insert": "The motion pass",
          "attributes": {
            "reference": {
              "kind": "source",
              "path": "scripts/design-score/run.ts",
              "symbol": "Motion"
            }
          }
        },
        {
          "insert": " runs twice. The second browser context sets "
        },
        {
          "insert": "reducedMotion: \"reduce\"",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "."
        }
      ],
      "children": []
    },
    "b16": {
      "id": "b16",
      "type": "list-item",
      "props": {
        "ordered": true
      },
      "text": [
        {
          "insert": "installMotionRecorder",
          "attributes": {
            "code": true,
            "reference": {
              "kind": "source",
              "path": "scripts/design-score/motion.ts",
              "symbol": "installMotionRecorder"
            }
          }
        },
        {
          "insert": " records during the page's actions. Then the run hovers and presses up to 12 controls, not 24."
        }
      ],
      "children": []
    },
    "b17": {
      "id": "b17",
      "type": "list-item",
      "props": {
        "ordered": true
      },
      "text": [
        {
          "insert": "The run",
          "attributes": {
            "reference": {
              "kind": "source",
              "path": "scripts/design-score/run.ts",
              "symbol": "Motion"
            }
          }
        },
        {
          "insert": " checks that "
        },
        {
          "insert": "matchMedia(\"(prefers-reduced-motion: reduce)\")",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " matches in the page. Without a match, the check reports nothing and its note says so."
        }
      ],
      "children": []
    },
    "b18": {
      "id": "b18",
      "type": "list-item",
      "props": {
