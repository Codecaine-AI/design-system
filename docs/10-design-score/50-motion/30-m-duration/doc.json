    "b1": {
      "id": "b1",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "M-duration",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " measures how long transitions and animations run when a person hovers or presses a control, or opens a menu, dialog or panel. It is a motion check, so it records real animations in Chromium, in the first theme and viewport. A duration over its limit fails the page."
        }
      ],
      "children": []
    },
    "b2": {
      "id": "b2",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "What It Catches"
        }
      ],
      "children": []
    },
    "b3": {
      "id": "b3",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The check sorts each animation into a kind by where it runs, and each kind has its own limit."
        }
      ],
      "children": []
    },
    "b4": {
      "id": "b4",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "Control hover and press",
          "attributes": {
            "bold": true
          }
        }
      ],
      "children": [
        "b5"
      ]
    },
    "b5": {
      "id": "b5",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "A transition that starts while the run holds "
        },
        {
          "insert": ":hover",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " or "
        },
        {
          "insert": ":hover:active",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " on a control fails when it runs longer than 200ms."
        }
      ],
      "children": []
    },
    "b6": {
      "id": "b6",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "Menus and popovers",
          "attributes": {
            "bold": true
          }
        }
      ],
      "children": [
        "b7"
      ]
    },
    "b7": {
      "id": "b7",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "An animation inside a menu, listbox, tooltip, "
        },
        {
          "insert": "[popover]",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " or Radix popper fails over 300ms."
        }
      ],
      "children": []
    },
    "b8": {
      "id": "b8",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "Dialogs and large panels",
          "attributes": {
            "bold": true
          }
        }
      ],
      "children": [
        "b9",
        "b10"
      ]
    },
    "b9": {
      "id": "b9",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "An animation inside a "
        },
        {
          "insert": "dialog",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", a "
        },
        {
          "insert": "role=\"dialog\"",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " or "
        },
        {
          "insert": "role=\"alertdialog\"",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", or "
        },
        {
          "insert": "[aria-modal=\"true\"]",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " fails over 450ms."
        }
      ],
      "children": []
    },
    "b10": {
      "id": "b10",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "An element that covers 15% of the viewport or more counts as a panel, with the same 450ms limit."
        }
      ],
      "children": []
    },
    "b11": {
      "id": "b11",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "Not judged",
          "attributes": {
            "bold": true
          }
        }
      ],
      "children": [
        "b12",
        "b13"
      ]
    },
    "b12": {
      "id": "b12",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "An infinite animation, such as a spinner, is skipped."
        }
      ],
      "children": []
    },
    "b13": {
      "id": "b13",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "Any other element has no limit, such as a toast outside every control, menu and dialog."
        }
      ],
      "children": []
    },
    "b14": {
      "id": "b14",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "How It Measures"
        }
      ],
      "children": []
    },
    "b15": {
      "id": "b15",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The run records every animation the page starts, then compares each one with the limit for its kind. It takes these steps in order."
        }
      ],
      "children": []
    },
    "b16": {
      "id": "b16",
      "type": "list-item",
      "props": {
        "ordered": true
      },
      "text": [
        {
          "insert": "scripts/design-score/run.ts",
          "attributes": {
            "code": true,
            "reference": {
              "kind": "source",
              "path": "scripts/design-score/run.ts",
              "symbol": "Motion"
            }
          }
        },
        {
          "insert": " opens each page in the first theme and viewport, with "
        },
        {
          "insert": "installMotionRecorder",
          "attributes": {
            "code": true,
            "reference": {
              "kind": "source",
              "path": "scripts/design-score/motion.ts",
              "symbol": "installMotionRecorder"
            }
          }
        },
        {
          "insert": " added before any page script."
        }
      ],
      "children": []
    },
    "b17": {
      "id": "b17",
      "type": "list-item",
      "props": {
        "ordered": true
      },
      "text": [
        {
          "insert": "The recorder polls "
        },
        {
          "insert": "document.getAnimations()",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " on every frame. It keeps each new animation's duration, delay, iterations, easing, properties and target."
        }
      ],
      "children": []
    },
    "b18": {
      "id": "b18",
      "type": "list-item",
      "props": {
        "ordered": true
      },
      "text": [
        {
          "insert": "The run records while the page's actions run. Then "
        },
        {
          "insert": "markMotionCandidates",
          "attributes": {
            "code": true,
            "reference": {
              "kind": "source",
              "path": "scripts/design-score/probes.ts",
              "symbol": "markMotionCandidates"
            }
          }
        },
        {
          "insert": " marks up to 24 visible controls, one per class signature."
        }
      ],
      "children": []
    },
    "b19": {
      "id": "b19",
      "type": "list-item",
      "props": {
        "ordered": true
      },
      "text": [
        {
          "insert": "For each control, "
        },
        {
          "insert": "the hover pass",
          "attributes": {
            "reference": {
              "kind": "source",
              "path": "scripts/design-score/run.ts",
              "symbol": "Motion"
            }
          }
        },
        {
          "insert": " forces "
        },
        {
          "insert": ":hover",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " through CDP "
        },
        {
          "insert": "CSS.forcePseudoState",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " for 110ms, then "
        },
        {
          "insert": ":hover:active",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " for 110ms. No click reaches the app."
        }
      ],
      "children": []
    },
    "b20": {
      "id": "b20",
      "type": "list-item",
      "props": {
        "ordered": true
      },
      "text": [
        {
          "insert": "readMotion",
          "attributes": {
            "code": true,
            "reference": {
              "kind": "source",
              "path": "scripts/design-score/motion.ts",
              "symbol": "readMotion"
            }
          }
        },
        {
          "insert": " gives each record a kind, and "
        },
        {
          "insert": "analyzeMotion",
          "attributes": {
            "code": true,
            "reference": {
              "kind": "source",
              "path": "scripts/design-score/motion.ts",
              "symbol": "analyzeMotion"
            }
          }
        },
        {
          "insert": " compares its duration with the kind's limit in "
        },
        {
          "insert": "LIMITS",
          "attributes": {
            "code": true,
            "reference": {
              "kind": "source",
              "path": "scripts/design-score/motion.ts",
              "symbol": "LIMITS"
            }
          }
        },
        {
          "insert": "."
        }
      ],
      "children": []
    },
    "b21": {
      "id": "b21",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "A record from a hover or press phase is always a control, whatever its size. The limit applies to the duration without the delay, and the finding shows the delay. Each selector, property list and kind reports once."
        }
      ],
      "children": []
    },
    "b22": {
      "id": "b22",
      "type": "heading",
      "props": {
