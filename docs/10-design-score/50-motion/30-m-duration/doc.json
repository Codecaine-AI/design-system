      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "A toast, a row or a card outside every control, menu and dialog has no limit."
        }
      ],
      "children": []
    },
    "b45": {
      "id": "b45",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "An animation that starts before recording starts is not recorded."
        }
      ],
      "children": []
    },
    "b46": {
      "id": "b46",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "Fix it in the app config",
          "attributes": {
            "bold": true
          }
        }
      ],
      "children": [
        "b47"
      ]
    },
    "b47": {
      "id": "b47",
      "type": "list-item",
      "props": {},
      "text": [
        {
          "insert": "Add a control's selector to "
        },
        {
          "insert": "ignore",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " in "
        },
        {
          "insert": "design-score/apps/<app>.json",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", so the run does not hover it. To skip the check on one page, use "
        },
        {
          "insert": "skip",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " and "
        },
        {
          "insert": "skipReason",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": "."
        }
      ],
      "children": []
    },
    "b48": {
      "id": "b48",
      "type": "heading",
      "props": {
        "level": 2
      },
      "text": [
        {
          "insert": "Debug It"
        }
      ],
      "children": []
    },
    "b49": {
      "id": "b49",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "Run these commands in the design-system checkout. Each run writes a folder under "
        },
        {
          "insert": ".design-score/",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " with "
        },
        {
          "insert": "scorecard.json",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", "
        },
        {
          "insert": "report.html",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " and one crop per finding."
        }
      ],
      "children": []
    },
    "b50": {
      "id": "b50",
      "type": "list-item",
      "props": {
        "ordered": true
      },
      "text": [
        {
          "insert": "Run the fixture pair. The command exits 1 unless the bad page fails and the good page passes."
        }
      ],
      "children": []
    },
    "b51": {
      "id": "b51",
      "type": "code",
      "props": {
        "language": "sh"
      },
      "text": [
        {
          "insert": "bun run design:score --fixture M-duration"
        }
      ],
      "children": []
    },
    "b52": {
      "id": "b52",
      "type": "list-item",
      "props": {
        "ordered": true
      },
      "text": [
        {
          "insert": "Score one page of an app in one theme and one viewport."
        }
      ],
      "children": []
    },
    "b53": {
      "id": "b53",
      "type": "code",
      "props": {
        "language": "sh"
      },
      "text": [
        {
          "insert": "bun run design:score --app knowledge-system --pages session --quick"
        }
      ],
      "children": []
    },
    "b54": {
      "id": "b54",
      "type": "list-item",
      "props": {
        "ordered": true
      },
