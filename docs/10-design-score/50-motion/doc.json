    "b1": {
      "id": "b1",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The motion checks read motion literals and "
        },
        {
          "insert": "transition: all",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " in the source, and record real animations while the run hovers and presses controls. The area has 2 static checks, 3 motion checks and 43 rules in "
        },
        {
          "insert": "design-score/rules/motion.json",
          "attributes": {
            "code": true,
            "reference": {
              "kind": "source",
              "path": "design-score/rules/motion.json"
            }
          }
        },
        {
          "insert": ". Each check page explains what the check measures and shows a good and a bad fixture with frame strips."
        }
      ],
      "children": []
    },
