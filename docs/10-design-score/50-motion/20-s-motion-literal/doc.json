    "b1": {
      "id": "b1",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "S-motion-literal",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " finds durations and easing curves written as literals instead of the motion tokens. It is a static check in the motion area, so it reads the app's source files with no browser. Every finding fails the check, and the result counts once on every page."
        }
      ],
      "children": []
    },
