              {
                "insert": "\"approve\": \"yes\"",
                "attributes": {
                  "code": true
                }
              },
              {
                "insert": "."
              }
            ]
          ],
          [
            [
              {
                "insert": "bun run progress [--root <dir>] [--baseline-lint <file>]",
