    "intro": {
      "id": "intro",
      "type": "paragraph",
      "props": {},
      "text": [
        {
          "insert": "The design-system commands build the package and check each app in the app registry, "
        },
        {
          "insert": "apps.json",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ". This page lists the build and app-check commands, the run profile that each app run uses, the Electron opt-in, the cleanup after a crashed run, and where results go. "
        },
        {
          "insert": "Design Score",
          "attributes": {
            "reference": {
              "kind": "doc",
              "path": "10-design-score"
            }
          }
        },
        {
          "insert": " covers "
        },
        {
          "insert": "design:score",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": ", and the "
        },
        {
          "insert": "design-system",
          "attributes": {
            "code": true
          }
        },
        {
          "insert": " skill gives the order in which you run the app checks."
        }
