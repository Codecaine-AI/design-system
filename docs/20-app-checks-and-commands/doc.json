              {
                "insert": "."
              }
            ]
          ],
          [
            [
              {
                "insert": "bun run registry:check [--root <dir>]",
                "attributes": {
                  "code": true
                }
              }
            ],
            [
              {
                "insert": "Checks the paths, ports, allowlists and fixtures in "
              },
              {
                "insert": "apps.json",
                "attributes": {
                  "code": true
