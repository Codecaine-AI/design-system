              {
                "insert": "--restore --root <dir>",
                "attributes": {
                  "code": true
                }
              },
              {
                "insert": " undoes an interrupted propagate."
              }
            ]
          ],
          [
            [
              {
                "insert": "bun run test:apps [--root <dir>] [--commands typecheck,build] [--no-tests] [--timeout <s>] [--json] app...",
                "attributes": {
                  "code": true
                }
              }
            ],
            [
              {
                "insert": "Runs the app's safe tests and named commands in the sandbox. Compares each result with "
              },
              {
                "insert": "tests.baselines",
                "attributes": {
                  "code": true
                }
              },
              {
                "insert": "."
              }
            ]
          ],
          [
            [
              {
                "insert": "bun run use:app --app <id> [--root <dir>] [--out-dir <dir>]",
                "attributes": {
                  "code": true
                }
              }
            ],
            "Uses the app in a browser. It visits each route in each theme, runs the route steps, toggles the sidebar and hovers controls."
