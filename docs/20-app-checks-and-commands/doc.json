              {
                "insert": "none",
                "attributes": {
                  "code": true
                }
              },
              {
                "insert": " gets a static check."
              }
            ]
          ],
          [
            [
              {
                "insert": "bun run verify:apps --propagate --root <dir>",
                "attributes": {
                  "code": true
                }
              }
            ],
            [
              {
                "insert": "Rebuilds with a sentinel page color and checks that live-linked apps paint it. "
