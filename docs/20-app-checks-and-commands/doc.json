          [
            [
              {
                "insert": "bun run snapshot --app <id> --set <name>",
                "attributes": {
                  "code": true
                }
              }
            ],
            "Takes a screenshot of each route in each theme."
          ],
          [
            [
              {
                "insert": "bun run snapshot:diff --app <id> --a <set> --b <set> [--exact]",
                "attributes": {
                  "code": true
                }
              }
            ],
            "Compares two shot sets pixel by pixel."
          ],
          [
            [
              {
                "insert": "bun run snapshot:sheet --app <id> --a <set> --b <set>",
                "attributes": {
                  "code": true
                }
              }
            ],
            "Writes a before and after sheet of two shot sets."
          ],
          [
            [
