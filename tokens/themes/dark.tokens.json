    "category": {
      "$description": "Categorical roster for series, tags and depth cycles, in this order.",
      "1": {
        "text": { "$type": "color", "$value": "{color.blue.text}", "$description": "Category 1 (blue)." },
        "soft": { "$type": "color", "$value": "{color.blue.soft}", "$description": "Category 1 fill." }
      },
      "2": {
        "text": { "$type": "color", "$value": "{color.teal.text}", "$description": "Category 2 (teal)." },
        "soft": { "$type": "color", "$value": "{color.teal.soft}", "$description": "Category 2 fill." }
