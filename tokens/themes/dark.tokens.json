      "soft": { "$type": "color", "$value": "color-mix(in srgb, {color.yellow.solid} 13%, {color.surface.panel})", "$description": "Pale yellow tint: the solid at 13% over the panel." },
      "line": { "$type": "color", "$value": "color-mix(in srgb, {color.yellow.solid} 50%, {color.surface.panel})", "$description": "Yellow hairline over a panel." }
    },
    "orange": {
      "text": { "$type": "color", "$value": "#dd7330", "$description": "Text-safe orange." },
      "solid": { "$type": "color", "$value": "#db6d28", "$description": "Orange tile or fill." },
      "on-solid": { "$type": "color", "$value": "{color.text.on-solid}", "$description": "Glyph on orange.solid. Light: ink, 5.03:1. Dark: near-black, 5.61:1." },
      "soft": { "$type": "color", "$value": "color-mix(in srgb, {color.orange.solid} 13%, {color.surface.panel})", "$description": "Pale orange tint: the solid at 13% over the panel." },
      "line": { "$type": "color", "$value": "color-mix(in srgb, {color.orange.solid} 50%, {color.surface.panel})", "$description": "Orange hairline over a panel." }
