{
  "color": {
    "surface": {
      "page": { "$type": "color", "$value": "#0d1117", "$description": "Page background (GitHub Primer canvas). Seed: --palette-page." },
      "panel": { "$type": "color", "$value": "#151b23", "$description": "Panels, cards, tables, trees. Seed: --palette-panel." },
      "sidebar": { "$type": "color", "$value": "#010409", "$description": "Sidebar surface, a step below the page (Primer canvas-inset). Seed: --palette-sidebar." },
      "sunken": { "$type": "color", "$value": "color-mix(in srgb, {color.text.ink} 5%, {color.surface.panel})", "$description": "Recessed well inside a panel. Seed: --docs-sunken." },
      "inset": { "$type": "color", "$value": "{color.surface.sidebar}", "$description": "Surface below the page: dark code panels on the dark page. Seed: --palette-inset." }
    },
    "text": {
      "ink": { "$type": "color", "$value": "#f0f6fc", "$description": "Titles, headings, strong text, field names. Seed: --palette-ink." },
      "body": { "$type": "color", "$value": "#d1d9e0", "$description": "Body text. Seed: --palette-text." },
      "secondary": { "$type": "color", "$value": "color-mix(in srgb, {color.text.body} 84%, transparent)", "$description": "Body text one step quieter. Seed: --docs-text-secondary." },
      "muted": { "$type": "color", "$value": "#9198a1", "$description": "Secondary text, >= 4.5:1 on page and panel. Seed: --palette-muted." },
      "faint": { "$type": "color", "$value": "#656c76", "$description": "Guides, gutters, placeholders. Not for text. Seed: --palette-faint." },
      "on-solid": { "$type": "color", "$value": "#0d1117", "$description": "Default glyph on a solid fill. On a hue or status solid use its own on-solid (color.yellow.on-solid): this one is under 4.5:1 on the light gray, yellow, orange and red solids. Seed: --palette-glyph." }
    },
    "border": {
      "default": { "$type": "color", "$value": "#3d444d", "$description": "Frames, rules, dividers, inputs. Seed: --palette-rule." },
      "subtle": { "$type": "color", "$value": "#262c36", "$description": "Row rules and inner separators. Seed: --palette-rule-soft." },
      "strong": { "$type": "color", "$value": "color-mix(in srgb, {color.border.default} 70%, {color.text.faint} 30%)", "$description": "Header rules that must read over a default rule. Seed: --docs-border-strong." },
      "guide": { "$type": "color", "$value": "color-mix(in srgb, {color.text.faint} 45%, {color.border.default})", "$description": "Tree indent guides. Seed: --docs-guide." },
      "image": { "$type": "color", "$value": "#ffffff1a", "$description": "Outline on images and media: pure white at 10%, never a tinted neutral. Inset it with border.width.hairline and a negative hairline offset." }
    },
    "fill": {
      "chip": { "$type": "color", "$value": "#21262d", "$description": "Inline code chips and neutral tags. Seed: --palette-chip." },
      "hover": { "$type": "color", "$value": "color-mix(in srgb, {color.text.ink} 6%, {color.surface.panel})", "$description": "Hover background of rows (tables, trees, disclosures, media buttons). Seed: --docs-hover." },
      "active": { "$type": "color", "$value": "{color.gray.soft}", "$description": "Selected or active row (sidebar selection), pressed toggles, button hover. Seed: --muted." },
      "accent": { "$type": "color", "$value": "{color.blue.soft}", "$description": "Accent wash behind an active tab or accent button; pair with color.blue.text. Seed: --accent." }
    },
    "accent": { "$type": "color", "$value": "#4493f8", "$description": "Interactive accent: selection outlines, drop indicators, toggles. Fills, borders and focus only: text uses color.link (light accent is 4.34:1 on the page, under AA). Seed: --palette-accent." },
    "link": { "$type": "color", "$value": "#4493f8", "$description": "Links and doc references. Seed: --palette-link." },
    "focus-ring": { "$type": "color", "$value": "{color.accent}", "$description": "Focus outline, >= 3:1 on page, panel and sidebar. Seed: --docs-focus-ring." },
    "selection": { "$type": "color", "$value": "color-mix(in srgb, {color.accent} 30%, transparent)", "$description": "Text selection; selected text keeps its own color. Seed: --docs-selection." },
    "gray": {
      "text": { "$type": "color", "$value": "#9198a1", "$description": "Text-safe gray." },
      "solid": { "$type": "color", "$value": "#656c76", "$description": "Gray tile or fill." },
      "on-solid": { "$type": "color", "$value": "#ffffff", "$description": "Glyph on gray.solid. Light: ink, 5.86:1. Dark: white, 5.30:1." },
      "soft": { "$type": "color", "$value": "color-mix(in srgb, {color.gray.solid} 13%, {color.surface.panel})", "$description": "Pale gray tint: the solid at 13% over the panel (Primer has no soft fills)." },
      "line": { "$type": "color", "$value": "color-mix(in srgb, {color.gray.solid} 50%, {color.surface.panel})", "$description": "Gray hairline over a panel." }
    },
    "blue": {
      "text": { "$type": "color", "$value": "#4493f8", "$description": "Text-safe blue." },
      "solid": { "$type": "color", "$value": "#4493f8", "$description": "Blue tile or fill." },
