      "on-solid": { "$type": "color", "$value": "{color.text.on-solid}", "$description": "Glyph on red.solid. Light: white, 4.26:1, the better glyph (ink is 3.87:1) but under AA for small text, so icons and large text only. Dark: near-black, 5.65:1." },
      "soft": { "$type": "color", "$value": "color-mix(in srgb, {color.red.solid} 13%, {color.surface.panel})", "$description": "Pale red tint: the solid at 13% over the panel." },
      "line": { "$type": "color", "$value": "color-mix(in srgb, {color.red.solid} 50%, {color.surface.panel})", "$description": "Red hairline over a panel." }
    },
    "violet": {
