      "soft": { "$type": "color", "$value": "color-mix(in srgb, {color.blue.solid} 13%, {color.surface.panel})", "$description": "Pale blue tint: the solid at 13% over the panel." },
      "line": { "$type": "color", "$value": "color-mix(in srgb, {color.blue.solid} 50%, {color.surface.panel})", "$description": "Blue hairline over a panel." }
    },
    "teal": {
      "text": { "$type": "color", "$value": "#39c5cf", "$description": "Text-safe teal." },
