      "on-solid": { "$type": "color", "$value": "{color.text.on-solid}", "$description": "Glyph on teal.solid. Light: white, 5.16:1. Dark: near-black, 9.07:1." },
      "soft": { "$type": "color", "$value": "color-mix(in srgb, {color.teal.solid} 13%, {color.surface.panel})", "$description": "Pale teal tint: the solid at 13% over the panel." },
      "line": { "$type": "color", "$value": "color-mix(in srgb, {color.teal.solid} 50%, {color.surface.panel})", "$description": "Teal hairline over a panel." }
    },
    "green": {
      "text": { "$type": "color", "$value": "#3fb950", "$description": "Text-safe green." },
      "solid": { "$type": "color", "$value": "#3fb950", "$description": "Green tile or fill." },
      "on-solid": { "$type": "color", "$value": "{color.text.on-solid}", "$description": "Glyph on green.solid. Light: white, 5.12:1. Dark: near-black, 7.45:1." },
      "soft": { "$type": "color", "$value": "color-mix(in srgb, {color.green.solid} 13%, {color.surface.panel})", "$description": "Pale green tint: the solid at 13% over the panel." },
      "line": { "$type": "color", "$value": "color-mix(in srgb, {color.green.solid} 50%, {color.surface.panel})", "$description": "Green hairline over a panel." }
    },
    "yellow": {
