        "keyword": { "$type": "color", "$value": "{color.syntax.keyword}", "$description": "Typed chip: keyword literals." },
        "prop": { "$type": "color", "$value": "{color.syntax.key}", "$description": "Typed chip: properties." }
      }
    },
