        "on-solid": { "$type": "color", "$value": "{color.blue.on-solid}", "$description": "Glyph on the info tile." },
        "soft": { "$type": "color", "$value": "{color.blue.soft}", "$description": "Info fill." },
        "line": { "$type": "color", "$value": "{color.blue.line}", "$description": "Info border." }
      },
      "success": {
        "text": { "$type": "color", "$value": "{color.green.text}", "$description": "Success text, icon and rail." },
        "solid": { "$type": "color", "$value": "{color.green.solid}", "$description": "Success tile." },
        "on-solid": { "$type": "color", "$value": "{color.green.on-solid}", "$description": "Glyph on the success tile." },
        "soft": { "$type": "color", "$value": "{color.green.soft}", "$description": "Success fill." },
        "line": { "$type": "color", "$value": "{color.green.line}", "$description": "Success border." }
      },
      "warning": {
        "text": { "$type": "color", "$value": "{color.amber.text}", "$description": "Warning text, icon and rail (amber, not olive yellow)." },
        "solid": { "$type": "color", "$value": "{color.yellow.solid}", "$description": "Warning tile." },
        "on-solid": { "$type": "color", "$value": "{color.yellow.on-solid}", "$description": "Glyph on the warning tile." },
        "soft": { "$type": "color", "$value": "{color.yellow.soft}", "$description": "Warning fill." },
        "line": { "$type": "color", "$value": "{color.yellow.line}", "$description": "Warning border." }
      },
      "danger": {
        "text": { "$type": "color", "$value": "{color.red.text}", "$description": "Danger and error text, icon and rail." },
        "solid": { "$type": "color", "$value": "{color.red.solid}", "$description": "Danger tile." },
        "on-solid": { "$type": "color", "$value": "{color.red.on-solid}", "$description": "Glyph on the danger tile." },
        "soft": { "$type": "color", "$value": "{color.red.soft}", "$description": "Danger fill." },
        "line": { "$type": "color", "$value": "{color.red.line}", "$description": "Danger border." }
      },
      "neutral": {
        "text": { "$type": "color", "$value": "{color.gray.text}", "$description": "Neutral status text." },
        "solid": { "$type": "color", "$value": "{color.gray.solid}", "$description": "Neutral tile." },
        "on-solid": { "$type": "color", "$value": "{color.gray.on-solid}", "$description": "Glyph on the neutral tile." },
        "soft": { "$type": "color", "$value": "{color.gray.soft}", "$description": "Neutral fill." },
        "line": { "$type": "color", "$value": "{color.gray.line}", "$description": "Neutral border." }
      }
    },
    "category": {
      "$description": "Categorical roster for series, tags and depth cycles, in this order.",
      "1": {
        "text": { "$type": "color", "$value": "{color.blue.text}", "$description": "Category 1 (blue)." },
        "soft": { "$type": "color", "$value": "{color.blue.soft}", "$description": "Category 1 fill." }
      },
