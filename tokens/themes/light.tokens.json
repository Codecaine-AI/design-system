      "mod-bg": { "$type": "color", "$value": "color-mix(in srgb, {color.yellow.solid} 9%, {color.surface.panel})", "$description": "Modified row tint." }
    },
    "syntax": {
      "$description": "Code token colors inside code panels: VS Code Light+ in light, Dark+ in dark.",
      "punctuation": { "$type": "color", "$value": "#000000", "$description": "Punctuation and plain code text." },
      "keyword": { "$type": "color", "$value": "#0000ff", "$description": "Declaration keywords (const, function, class)." },
