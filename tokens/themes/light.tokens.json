{
  "color": {
    "surface": {
      "page": { "$type": "color", "$value": "#fdfdfd", "$description": "Page background: warm paper off-white (1% below white so the grain overlay can brighten). Seed: --palette-page." },
      "panel": { "$type": "color", "$value": "#f8f8f7", "$description": "Panels, cards, tables, trees. Seed: --palette-panel." },
      "sidebar": { "$type": "color", "$value": "#f9f9f9", "$description": "Sidebar surface, a step deeper than the page. Seed: --palette-sidebar." },
      "sunken": { "$type": "color", "$value": "color-mix(in srgb, {color.text.ink} 5%, {color.surface.panel})", "$description": "Recessed well inside a panel. Seed: --docs-sunken." },
      "inset": { "$type": "color", "$value": "{color.surface.sidebar}", "$description": "Surface that sits below the page (Primer canvas-inset). Seed: --palette-inset (dark only in docs-system)." }
    },
    "text": {
      "ink": { "$type": "color", "$value": "#1f1f1f", "$description": "Titles, headings, strong text, field names. Seed: --palette-ink." },
      "body": { "$type": "color", "$value": "#2a2a2a", "$description": "Body text (AA). Seed: --palette-text." },
      "secondary": { "$type": "color", "$value": "color-mix(in srgb, {color.text.body} 84%, transparent)", "$description": "Body text one step quieter. Seed: --docs-text-secondary." },
      "muted": { "$type": "color", "$value": "#666562", "$description": "Secondary text, >= 4.5:1 on page and panel. Seed: --palette-muted." },
      "faint": { "$type": "color", "$value": "#9b9a97", "$description": "Guides, gutters, placeholders. Not for text. Seed: --palette-faint." },
      "on-solid": { "$type": "color", "$value": "#ffffff", "$description": "Default glyph on a solid fill. On a hue or status solid use its own on-solid (color.yellow.on-solid): this one is under 4.5:1 on the light gray, yellow, orange and red solids. Seed: --palette-glyph." }
    },
    "border": {
      "default": { "$type": "color", "$value": "#e6e5e3", "$description": "Frames, rules, dividers, inputs. Seed: --palette-rule." },
      "subtle": { "$type": "color", "$value": "#efeeec", "$description": "Row rules and inner separators. Seed: --palette-rule-soft." },
      "strong": { "$type": "color", "$value": "color-mix(in srgb, {color.border.default} 70%, {color.text.faint} 30%)", "$description": "Header rules that must read over a default rule. Seed: --docs-border-strong." },
      "guide": { "$type": "color", "$value": "color-mix(in srgb, {color.text.faint} 45%, {color.border.default})", "$description": "Tree indent guides. Seed: --docs-guide." }
    },
    "fill": {
      "chip": { "$type": "color", "$value": "#ebebe9", "$description": "Inline code chips and neutral tags. Seed: --palette-chip." },
      "hover": { "$type": "color", "$value": "color-mix(in srgb, {color.text.ink} 6%, {color.surface.panel})", "$description": "Hover background of rows (tables, trees, disclosures, media buttons). Seed: --docs-hover." },
      "active": { "$type": "color", "$value": "{color.gray.soft}", "$description": "Selected or active row (sidebar selection), pressed toggles, button hover. Seed: --muted." },
      "accent": { "$type": "color", "$value": "{color.blue.soft}", "$description": "Accent wash behind an active tab or accent button; pair with color.blue.text. Seed: --accent." }
    },
    "accent": { "$type": "color", "$value": "#0078df", "$description": "Interactive accent: selection outlines, drop indicators, toggles. Fills, borders and focus only: text uses color.link (light accent is 4.34:1 on the page, under AA). Seed: --palette-accent." },
    "link": { "$type": "color", "$value": "#245a81", "$description": "Links and doc references. Seed: --palette-link." },
    "focus-ring": { "$type": "color", "$value": "{color.accent}", "$description": "Focus outline, >= 3:1 on page, panel and sidebar. Seed: --docs-focus-ring." },
    "selection": { "$type": "color", "$value": "color-mix(in srgb, {color.accent} 18%, transparent)", "$description": "Text selection; selected text keeps its own color. Seed: --docs-selection." },
    "gray": {
      "text": { "$type": "color", "$value": "#666562", "$description": "Text-safe gray (>= 4.5:1 on page, panel and gray.soft)." },
      "solid": { "$type": "color", "$value": "#9b9a97", "$description": "Gray tile or fill." },
      "on-solid": { "$type": "color", "$value": "{color.text.ink}", "$description": "Glyph on gray.solid. Light: ink, 5.86:1. Dark: white, 5.30:1." },
      "soft": { "$type": "color", "$value": "#ebeced", "$description": "Opaque pale gray tint." },
      "line": { "$type": "color", "$value": "color-mix(in srgb, {color.gray.solid} 45%, {color.surface.panel})", "$description": "Gray hairline over a panel." }
    },
    "blue": {
