      "solid": { "$type": "color", "$value": "#287c55", "$description": "Green tile or fill." },
      "on-solid": { "$type": "color", "$value": "{color.text.on-solid}", "$description": "Glyph on green.solid. Light: white, 5.12:1. Dark: near-black, 7.45:1." },
      "soft": { "$type": "color", "$value": "#e2efe6", "$description": "Opaque pale green tint." },
