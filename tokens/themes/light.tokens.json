      "comment": { "$type": "color", "$value": "#008000", "$description": "Comments." },
      "regex": { "$type": "color", "$value": "#811f3f", "$description": "Regular expressions." },
      "tag": { "$type": "color", "$value": "#800000", "$description": "Markup tag names." },
      "constant": { "$type": "color", "$value": "#0070c1", "$description": "UPPER_CASE constants and entities." },
      "selector": { "$type": "color", "$value": "#800000", "$description": "CSS selectors." }
    },
    "code": {
      "bg": { "$type": "color", "$value": "color-mix(in srgb, {color.gray.soft} 30%, transparent)", "$description": "Code panel background when code panels follow the light page." },
      "border": { "$type": "color", "$value": "{color.border.default}", "$description": "Code panel frame." },
