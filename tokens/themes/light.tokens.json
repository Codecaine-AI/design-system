      "on-solid": { "$type": "color", "$value": "{color.text.on-solid}", "$description": "Glyph on teal.solid. Light: white, 5.16:1. Dark: near-black, 9.07:1." },
      "soft": { "$type": "color", "$value": "#ddedea", "$description": "Opaque pale teal tint." },
      "line": { "$type": "color", "$value": "color-mix(in srgb, {color.teal.solid} 45%, {color.surface.panel})", "$description": "Teal hairline over a panel." }
