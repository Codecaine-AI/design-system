        "green": { "$type": "color", "$value": "#0f7b6c", "$description": "Seed: --color-text-green." },
        "blue": { "$type": "color", "$value": "#0b6e99", "$description": "Seed: --color-text-blue (highlight, drag-select and drop-line color)." },
        "purple": { "$type": "color", "$value": "#6940a5", "$description": "Seed: --color-text-purple." },
        "pink": { "$type": "color", "$value": "#ad1a72", "$description": "Seed: --color-text-pink." },
        "red": { "$type": "color", "$value": "#e03e3e", "$description": "Seed: --color-text-red." }
      },
