      "on-solid": { "$type": "color", "$value": "{color.text.on-solid}", "$description": "Glyph on pink.solid. Light: white, 6.63:1. Dark: near-black, 5.63:1." },
      "soft": { "$type": "color", "$value": "#f4dfeb", "$description": "Opaque pale pink tint." },
      "line": { "$type": "color", "$value": "color-mix(in srgb, {color.pink.solid} 45%, {color.surface.panel})", "$description": "Pink hairline over a panel." }
    },
    "amber": {
      "text": { "$type": "color", "$value": "#9a5b00", "$description": "Warning text: a clear amber (5.3:1 on the page) where yellow.text reads olive. Seed: --palette-amber." }
    },
    "status": {
      "info": {
        "text": { "$type": "color", "$value": "{color.blue.text}", "$description": "Info text, icon and rail." },
