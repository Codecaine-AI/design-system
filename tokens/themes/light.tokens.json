      "on-solid": { "$type": "color", "$value": "{color.text.ink}", "$description": "Glyph on yellow.solid. Light: ink, 7.82:1. Dark: near-black, 7.50:1." },
      "soft": { "$type": "color", "$value": "#fbf3db", "$description": "Opaque pale yellow tint." },
      "line": { "$type": "color", "$value": "color-mix(in srgb, {color.yellow.solid} 45%, {color.surface.panel})", "$description": "Yellow hairline over a panel." }
    },
    "orange": {
      "text": { "$type": "color", "$value": "#9d530d", "$description": "Text-safe orange." },
      "solid": { "$type": "color", "$value": "#d9730d", "$description": "Orange tile or fill." },
      "on-solid": { "$type": "color", "$value": "{color.text.ink}", "$description": "Glyph on orange.solid. Light: ink, 5.03:1. Dark: near-black, 5.61:1." },
      "soft": { "$type": "color", "$value": "#faebdd", "$description": "Opaque pale orange tint." },
      "line": { "$type": "color", "$value": "color-mix(in srgb, {color.orange.solid} 45%, {color.surface.panel})", "$description": "Orange hairline over a panel." }
    },
    "red": {
      "text": { "$type": "color", "$value": "#c62121", "$description": "Text-safe red." },
      "solid": { "$type": "color", "$value": "#e03e3e", "$description": "Red tile or fill." },
      "on-solid": { "$type": "color", "$value": "{color.text.on-solid}", "$description": "Glyph on red.solid. Light: white, 4.26:1, the better glyph (ink is 3.87:1) but under AA for small text, so icons and large text only. Dark: near-black, 5.65:1." },
      "soft": { "$type": "color", "$value": "#fbe4e4", "$description": "Opaque pale red tint." },
      "line": { "$type": "color", "$value": "color-mix(in srgb, {color.red.solid} 45%, {color.surface.panel})", "$description": "Red hairline over a panel." }
    },
    "violet": {
      "text": { "$type": "color", "$value": "#6940a5", "$description": "Text-safe violet." },
      "solid": { "$type": "color", "$value": "#6940a5", "$description": "Violet tile or fill." },
      "on-solid": { "$type": "color", "$value": "{color.text.on-solid}", "$description": "Glyph on violet.solid. Light: white, 7.30:1. Dark: near-black, 6.33:1." },
      "soft": { "$type": "color", "$value": "#eae4f2", "$description": "Opaque pale violet tint." },
      "line": { "$type": "color", "$value": "color-mix(in srgb, {color.violet.solid} 45%, {color.surface.panel})", "$description": "Violet hairline over a panel." }
