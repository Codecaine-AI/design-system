{
  "motion": {
    "duration": {
      "fast": { "$type": "duration", "$value": "100ms", "$description": "Hover fills, grip fade." },
      "base": { "$type": "duration", "$value": "150ms", "$description": "Toggles, color changes." },
      "slow": { "$type": "duration", "$value": "260ms", "$description": "Panel open, resize and tab slide (glass panel)." }
    },
    "easing": {
      "standard": { "$type": "cubicBezier", "$value": "ease", "$description": "Default for small state changes." },
      "emphasized": { "$type": "cubicBezier", "$value": "cubic-bezier(0.32, 0.72, 0, 1)", "$description": "Panels entering, resizing or sliding." },
      "decelerate": { "$type": "cubicBezier", "$value": "ease-out", "$description": "Fades out of a highlight, hover hints appearing." }
    }
  },
  "z": {
    "raised": { "$type": "number", "$value": 20, "$description": "Floating grips, docked rails above content." },
    "panel": { "$type": "number", "$value": 30, "$description": "Floating glass panels." },
    "overlay": { "$type": "number", "$value": 40, "$description": "Drag overlays, drop indicators, tooltips over panels." },
    "popover": { "$type": "number", "$value": 50, "$description": "Menus and popovers." },
    "top": { "$type": "number", "$value": 60, "$description": "Full-viewport effect layers (grain); never interactive." }
  }
}
