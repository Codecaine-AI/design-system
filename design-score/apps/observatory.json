{
  "app": "observatory",
  "name": "Observatory",
  "repo": "codecaine/core/observatory",
  "baseUrl": "http://127.0.0.1:47620",
  "sourceDirs": [
    "src/ui"
  ],
  "themes": {
    "light": {
      "localStorage": {
        "observatory.viewerStyle.v2": "{\"theme\":\"light\"}"
      },
      "colorScheme": "light",
      "assert": "html[data-theme=\"light\"]"
    },
    "dark": {
      "localStorage": {
        "observatory.viewerStyle.v2": "{\"theme\":\"dark\"}"
      },
      "colorScheme": "dark",
      "assert": "html[data-theme=\"dark\"]"
    }
  },
  "viewports": [
    {
      "width": 1440,
      "height": 900
    },
    {
      "width": 1024,
      "height": 768
    }
  ],
  "settleMs": 700,
  "loading": [
    "Loading agent catalog"
  ],
  "cap": 6,
  "pages": [
    {
      "id": "traces",
      "path": "/",
      "waitFor": "text=fn_8003A1C4 in d_a_player.cpp",
      "note": "Home: the first project (live harness) on its Traces list. The fixture registry has a live project, an offline project with traces and an offline project with no trace database."
    },
    {
      "id": "trace-detail",
      "path": "/",
      "waitFor": "text=State demo: counter and checklist",
      "actions": [
        {
          "click": "text=State demo: counter and checklist"
        },
        {
          "waitFor": "text=All traces"
        }
      ],
      "note": "A trace open: the span tree and the empty inspector."
    },
    {
      "id": "trace-event",
      "path": "/",
      "waitFor": "text=State demo: counter and checklist",
      "actions": [
        {
          "click": "text=State demo: counter and checklist"
        },
        {
          "waitFor": "text=Turn one: probe the alpha note."
        },
        {
          "click": "text=Turn one: probe the alpha note. >> nth=0"
        },
        {
          "wait": 400
        }
      ],
      "note": "A trace with a user-message span selected, so the inspector shows it."
    },
    {
      "id": "agents",
      "path": "/",
      "waitFor": "aside",
      "actions": [
        {
          "click": "li:nth-child(1) button:has-text(\"agents\")"
        },
        {
          "waitFor": "text=Rendered prompt"
        }
      ],
      "note": "The live project's Agents page: the catalog list and the read-only prompt of the first agent."
    },
    {
      "id": "traces-offline",
      "path": "/",
      "waitFor": "aside",
      "actions": [
        {
          "click": "li:nth-child(2) button:has-text(\"traces\")"
        },
        {
          "waitFor": "text=Harness not running"
        }
      ],
      "note": "An offline project's Traces list, read from its local SQLite database."
    },
    {
      "id": "agents-offline",
      "path": "/",
      "waitFor": "aside",
      "actions": [
        {
          "click": "li:nth-child(2) button:has-text(\"agents\")"
        },
        {
          "waitFor": "text=Agents unavailable"
        }
      ],
      "note": "An offline project's Agents page: the unavailable panel."
    },
    {
      "id": "traces-empty",
      "path": "/",
      "waitFor": "aside",
      "actions": [
        {
          "click": "li:nth-child(3) button:has-text(\"traces\")"
        },
        {
          "waitFor": "text=No traces yet"
        }
      ],
      "note": "An offline project with no trace database."
    },
    {
      "id": "no-projects",
      "path": "/",
      "waitFor": "text=Add a project to registry.json",
      "mock": [
        {
          "path": "/registry/projects",
          "merge": {
            "projects": []
          }
        }
      ],
      "note": "An empty registry. The fixture registry has projects, so the projects response is mocked empty."
    }
  ]
}
