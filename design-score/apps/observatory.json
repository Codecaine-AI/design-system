{
  "app": "observatory",
  "name": "Observatory",
  "repo": "codecaine/core/observatory",
  "baseUrl": "http://127.0.0.1:47620",
  "sourceDirs": [
    "src/ui"
  ],
  "themes": {
    "light": {
      "localStorage": {
        "observatory.theme": "light"
      },
      "colorScheme": "light",
      "assert": "html[data-theme=\"light\"]"
    },
    "dark": {
      "localStorage": {
        "observatory.theme": "dark"
      },
      "colorScheme": "dark",
      "assert": "html[data-theme=\"dark\"]"
    }
  },
  "viewports": [
    {
      "width": 1440,
      "height": 900
    },
    {
      "width": 1024,
      "height": 768
    }
  ],
  "settleMs": 700,
  "loading": [
    "Reading the action log"
  ],
  "cap": 6,
  "pages": [
    {
      "id": "actions",
      "path": "/",
      "waitFor": "text=prompts_apply_ops",
      "note": "The action log with seven records from two threads and one thread-less run."
    },
    {
      "id": "actions-filtered",
      "path": "/",
      "waitFor": "text=prompts_apply_ops",
      "actions": [
        {
          "click": "text=thread-91bc >> nth=0"
        },
        {
          "waitFor": "text=3 actions"
        }
      ],
      "note": "Filtered by one thread, set by clicking the thread cell."
    },
    {
      "id": "actions-empty",
      "path": "/",
      "waitFor": "text=No actions match",
      "mock": [
        {
          "path": "/api/actions",
          "merge": {
            "records": []
          }
        }
      ],
      "note": "An empty log."
    },
    {
      "id": "registry-error",
      "path": "/",
      "waitFor": "aside",
      "mock": [
        {
          "path": "/registry/projects",
          "merge": {
            "projects": []
          }
        }
      ],
      "note": "No registered projects."
    }
  ]
}
