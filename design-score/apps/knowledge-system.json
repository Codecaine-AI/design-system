{
  "app": "knowledge-system",
  "name": "Knowledge System",
  "repo": "lascari-ai/knowledge-system",
  "baseUrl": "http://127.0.0.1:4961",
  "sourceDirs": [
    "app/src"
  ],
  "themes": {
    "light": {
      "localStorage": {
        "knowledge.theme": "light"
      },
      "colorScheme": "light",
      "assert": "html[data-theme=\"light\"]"
    },
    "dark": {
      "localStorage": {
        "knowledge.theme": "dark"
      },
      "colorScheme": "dark",
      "assert": "html[data-theme=\"dark\"]"
    }
  },
  "viewports": [
    {
      "width": 1440,
      "height": 900
    },
    {
      "width": 1024,
      "height": 768
    }
  ],
  "handles": [
    ".docs-drag-handle"
  ],
  "ignore": [
    "iframe"
  ],
  "settleMs": 700,
  "loading": [
    "Loading page"
  ],
  "cap": 6,
  "shift": {
    "open": [
      "button[aria-label^=\"Edit \"]"
    ],
    "max": 16
  },
  "motionAllow": [
    {
      "name": "ds-shell-sidebar",
      "selector": ".ds-shell",
      "props": [
        "grid-template-columns"
      ],
      "reason": "The design-system app shell animates its sidebar column when it collapses (css/layout.css .ds-shell). The shell owns it; allowed by Ford."
    }
  ],
  "pages": [
    {
      "id": "inbox",
      "path": "/inbox",
      "waitFor": ".ds-shell",
      "note": "Home: / redirects here."
    },
    {
      "id": "place-area",
      "path": "/place/ent_01JB871HFE865V215DE1CTEWH0",
      "waitFor": ".ds-shell",
      "note": "An Area page (Making)."
    },
    {
      "id": "session",
      "path": "/session/task_01JBB2M6F1NY8QA3RX9SU6WP4D",
      "waitFor": ".ds-shell",
      "note": "A Session page (Ink Layering) on its default tab."
    },
    {
      "id": "library-topic",
      "path": "/library/topic/ent_01M4F7BTW84KJP7Q2FCXKH81F6",
      "waitFor": ".ds-shell",
      "note": "A Library Topic (Pen Plotting)."
    },
    {
      "id": "codebase",
      "path": "/codebase/ent_01M4F4HF3XJZE2E9QW5TYKBS2X",
      "waitFor": ".ds-shell",
      "note": "A Codebase page (Knowledge System)."
    },
    {
      "id": "docs-editor-hover",
      "path": "/session/task_01JBB2M6F1NY8QA3RX9SU6WP4D?tab=spec",
      "waitFor": ".ProseMirror",
      "actions": [
        {
          "hover": ".ProseMirror > p"
        },
        {
          "waitFor": ".docs-drag-handle-visible"
        }
      ],
      "note": "The Spec doc open in the docs editor, first paragraph hovered so the grab handle shows.",
      "optional": "the docs editor needs the docs hub to know this knowledge root (only the registered sample-knowledge does)"
    },
    {
      "id": "docs-editor-hover-heading",
      "path": "/session/task_01JBB2M6F1NY8QA3RX9SU6WP4D?tab=spec",
      "waitFor": ".ProseMirror",
      "actions": [
        {
          "hover": ".ProseMirror > h2"
        },
        {
          "waitFor": ".docs-drag-handle-visible"
        }
      ],
      "note": "The same doc with a heading block hovered: the grab handle against a heading's first line.",
      "optional": "the docs editor needs the docs hub to know this knowledge root (only the registered sample-knowledge does)"
    },
    {
      "id": "side-peek",
      "path": "/sessions?peek=task_01JBB2M6F1NY8QA3RX9SU6WP4D",
      "waitFor": ".side-peek",
