{
  "app": "variator",
  "name": "Variator review",
  "repo": "codecaine/tools/variator",
  "registryApp": "variator",
  "sourceDirs": [
    "src/web"
  ],
  "themes": {
    "light": {
      "query": {
        "theme": "light"
      },
      "colorScheme": "light",
      "assert": "html[data-theme=\"light\"]"
    },
    "dark": {
      "query": {
        "theme": "dark"
      },
      "colorScheme": "dark",
      "assert": "html[data-theme=\"dark\"]"
    }
  },
  "viewports": [
    {
      "width": 1440,
      "height": 900
    },
    {
      "width": 1024,
      "height": 768
    }
  ],
  "ignore": [
    "iframe"
  ],
  "settleMs": 700,
  "loading": [
    "Loading…"
  ],
  "cap": 6,
  "pages": [
    {
      "id": "review",
      "path": "/?batch=sample-notes-home-r1",
      "waitFor": ".stage .frame-box iframe",
      "note": "The review screen on an open batch: Submit round in the tool bar, Screenshot in the caption bar, Pick and the note fields in the dock, and one pinned note. registryApp starts Variator in the sandbox on the batch apps/fixtures/variator/seed.ts seeds (two variations, one note). The frames are iframes holding fixture pages and are not measured."
    },
    {
      "id": "review-variation-02",
      "path": "/?batch=sample-notes-home-r1",
      "waitFor": ".stage .frame-box iframe",
      "actions": [
        {
          "click": "button[role=\"tab\"][aria-label^=\"Variation 02\"]"
        },
        {
          "waitFor": "button[role=\"tab\"][aria-label^=\"Variation 02\"][aria-selected=\"true\"]"
        }
      ],
      "note": "The second variation chosen in the frame's tab strip: the dock title moves and the dock shows the empty hint (no notes on it yet)."
    },
    {
      "id": "review-split",
      "path": "/?batch=sample-notes-home-r1",
      "waitFor": ".stage .frame-box iframe",
      "actions": [
        {
          "click": "button:has-text(\"Split\")"
        },
        {
          "waitFor": ".app[data-split]"
        },
        {
          "wait": 400
        }
      ],
      "note": "Split: two frames side by side, each with its own caption bar and a tab strip that shows numbers only."
    },
    {
      "id": "review-dock-closed",
      "path": "/?batch=sample-notes-home-r1",
      "waitFor": ".stage .frame-box iframe",
      "actions": [
        {
          "click": "button[aria-controls=\"dock\"]"
        },
        {
          "waitFor": ".app[data-dock=\"closed\"]"
        }
      ],
      "note": "Notes toggled off: the stage takes the full width."
    },
    {
      "id": "review-meta-open",
      "path": "/?batch=sample-notes-home-r1",
      "waitFor": ".dock details.meta",
      "actions": [
        {
          "click": "details.meta summary"
        },
        {
          "waitFor": "details.meta[open]"
        }
      ],
      "note": "The dock's Direction and intent disclosure open."
    },
    {
      "id": "review-submit-confirm",
      "path": "/?batch=sample-notes-home-r1",
      "waitFor": ".bar .submit",
      "actions": [
        {
          "click": ".bar .submit:has-text(\"Submit round\")"
        },
        {
          "waitFor": ".bar .confirm"
        }
      ],
      "note": "The tool bar's Submit round confirm step. No step presses its Submit button, and the scorer aborts every non-GET request anyway."
    }
  ]
}
